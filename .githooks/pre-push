#!/bin/sh
# What each pushed ref carries that its remote does not have yet (scripts/check.sh). Deleting a ref checks nothing.
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    # A new branch: against where it left main.
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || git rev-list --max-parents=0 "$local_sha" | tail -1)
  else
    base=$remote_sha
  fi
  echo "checking $local_ref ($(git rev-list --count "$base..$local_sha") commits)"
  sh "$root/scripts/check.sh" push "$base..$local_sha" || status=1
done
exit $status
