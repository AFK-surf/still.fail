#!/bin/sh
# The quick check (scripts/check.sh) on what each pushed ref carries that its remote does not have yet. Deleting a
# ref checks nothing.
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    # A new branch: against where it left main.
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || git rev-list --max-parents=0 "$local_sha" | tail -1)
  else
    base=$remote_sha
    # A branch brought up to main since its remote's (main merged into it, or rebased onto a later main): against where
    # it leaves main now, as CI checks it. Against its remote's it would be all main got meanwhile, none of it this push's.
    left=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
    if [ -n "$left" ] && ! git merge-base --is-ancestor "$left" "$remote_sha" 2>/dev/null; then base=$left; fi
  fi
  echo "checking $local_ref ($(git rev-list --count "$base..$local_sha") commits)"
  sh "$root/scripts/check.sh" push "$base..$local_sha" || status=1
  # Nothing merged into main undone, against where it left main (a branch pushed again after a rebase too).
  if [ -z "${STILLFAIL_SKIP_CHECKS:-${EMBER_SKIP_CHECKS:-}}" ]; then
    left=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "$base")
    sh "$root/scripts/undone.sh" "$left" "$local_sha" || status=1
  fi
done
exit $status
