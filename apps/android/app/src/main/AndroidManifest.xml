<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- mDNS: stations on the LAN are found without still.fail cloud (MainActivity's multicast lock). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- The app installs its own newer builds (Updates.kt). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Notices of the chats one takes part in (Notices.kt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="still.fail"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.StillFail"
        android:supportsRtl="true"
        android:allowBackup="false">
        <!-- Frame stats and profiles from the shell, on an optimized build too. -->
        <profileable android:shell="true" />
        <!-- Turning the phone (or the video viewer's landscape button) keeps the activity: recreating it would rebuild
             AppState and drop the screens back to Home; Compose lays out again on its own. So does switching the
             system's dark mode (uiMode): Compose reads it from the configuration, and MainActivity sets the system bars
             and the window's background again as it changes. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- still.fail cloud's sign-in returns here (auth.begin's redirect_uri): stillfail://, and ember:// from before
                 the rename (still accepted). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="stillfail" android:host="auth" android:path="/callback" />
                <data android:scheme="ember" android:host="auth" android:path="/callback" />
            </intent-filter>
            <!-- An item's link (a session's link in Slack): the app opens it, verified by still.fail cloud's assetlinks.json
                 (served on both hosts: app.still.fail, and ember.3720.org from before the rename). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.still.fail" android:pathPrefix="/o/" />
                <data android:scheme="https" android:host="ember.3720.org" android:pathPrefix="/o/" />
            </intent-filter>
            <!-- An invitation's link (/invite#<token>) and a chat's link as chats refer to each other (/w/<ws>/s/<station>/chats/<key>). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.still.fail" android:path="/invite" />
                <data android:scheme="https" android:host="app.still.fail" android:pathPattern="/w/.*/s/.*/chats/.*" />
                <data android:scheme="https" android:host="ember.3720.org" android:path="/invite" />
                <data android:scheme="https" android:host="ember.3720.org" android:pathPattern="/w/.*/s/.*/chats/.*" />
            </intent-filter>
        </activity>
        <!-- What the installer says of an update (Updates.kt). -->
        <receiver android:name=".InstallResult" android:exported="false" />
        <!-- FCM's pushes (Push.kt). Firebase is set up by hand from BuildConfig (no google-services.json): its own
             start-up provider is taken out, and no token is made before Push.sync asks for one. -->
        <service android:name=".PushService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
    </application>

    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
</manifest>
