{
  "name": "@ember/desktop",
  "productName": "ember",
  "version": "0.1.0",
  "description": "ember",
  "private": true,
  "main": "build/app/main.js",
  "scripts": {
    "build": "sh build.sh",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "dev.ember.desktop",
    "productName": "ember",
    "directories": {
      "output": "out"
    },
    "files": [
      "build/app/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/web",
        "to": "web"
      },
      {
        "from": "build/ember_core.node",
        "to": "ember_core.node"
      },
      {
        "from": "build/station/ember",
        "to": "station"
      }
    ],
    "protocols": [
      {
        "name": "ember",
        "schemes": [
          "ember"
        ]
      }
    ],
    "mac": {
      "target": "dir",
      "identity": "Apple Development: zuozijian1994@gmail.com (9C49UVFRK3)",
      "icon": "../../web/public/icon-512.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "ember connects straight to your stations on the local network when it can."
      }
    },
    "electronDist": "node_modules/electron/dist"
  },
  "packageManager": "pnpm@10.11.1"
}
