{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "still.fail",
  "description": "__MSG_description__",
  "version": "0.1.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "__MSG_action__",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://app.still.fail/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://app.still.fail/*",
      "https://*.still.fail/*",
      "https://app.youdid.wtf/*",
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
