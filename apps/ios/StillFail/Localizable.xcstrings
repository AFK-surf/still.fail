        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제거 후 이 워크스페이스는 해당 노드에 연결할 수 없습니다. 대상 컴퓨터의 소프트웨어와 로컬 파일은 지워지지 않습니다."
          }
