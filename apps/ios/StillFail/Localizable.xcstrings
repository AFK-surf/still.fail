          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有其他成員可以接任。刪除工作區需要單獨確認，但當前階段最終刪除仍鎖定。"
          }
        }
      }
    },
