{
  "//": "still.fail mbui's APK as mbui's scripts/apk builds it (no Gradle): fail.still.mbui, its debug build .debug; as still.fail's Android app in its place (variants stable and beta: fail.still.android and fail.still.android.beta, their names, icons' colours and update feeds, the beta's core a beta's, as still.fail mbui's is: a build of every commit, the test channel's). Its host is mbui's (the Java of libs/mbui/android) with the still.fail core's (CoreHost.java here); libmbui.so and the core's parts are put by scripts/android.sh where jniLibs and assets say. The release: R8 over the Java (Media3's most of it), signed as every still.fail Android release is (the debug keystore $ANDROID_USER_HOME holds), its versionCode the build (git rev-list --count HEAD), versionName 0.1.<build>, its update feed android/mbui. PostHog's project from the file $STILLFAIL_POSTHOG names ({host, key}), as string resources Crashes.java reads.",
  "namespace": "dev.mbui",
  "applicationId": "fail.still.mbui",
  "minSdk": 30,
  "targetSdk": 36,
  "compileSdk": 36,
  "manifest": "app/src/main/AndroidManifest.xml",
  "java": ["app/src/main/java", "../../../libs/mbui/android/app/src/main/java", "../../../libs/mbui/android/jzlib/src"],
  "res": ["../../../libs/mbui/android/app/src/main/res", "app/src/main/res"],
  "assets": ["../out/android/apk/assets"],
  "jniLibs": ["../out/android/apk/jniLibs", "app/src/main/jniLibs"],
  "rules": ["app/proguard-rules.pro"],
  "lock": "apk.lock",
  "merged": ["androidx.core:core:", "androidx.window:window:", "androidx.profileinstaller:", "androidx.startup:", "com.google.firebase:", "com.google.android.gms:", "com.google.android.datatransport:"],
  "strings": {
    "posthog_host": ["STILLFAIL_POSTHOG", "host"],
    "posthog_key": ["STILLFAIL_POSTHOG", "key"]
  },
  "variants": {
    "release": {
      "minify": true,
      "placeholders": {"appHost": "app.still.fail", "appLabel": "still.fail preview", "mbuiEnv": "MBUI_UPDATE_FEED=android/mbui;MBUI_BETA=1"}
    },
    "stable": {
      "applicationId": "fail.still.android",
      "minify": true,
      "res": ["app/src/stable/res"],
      "placeholders": {"appHost": "app.still.fail", "appLabel": "still.fail", "mbuiEnv": "MBUI_UPDATE_FEED=android;MBUI_OWN=1"}
    },
    "beta": {
      "applicationId": "fail.still.android.beta",
      "minify": true,
      "res": ["app/src/beta/res"],
      "placeholders": {"appHost": "app.still.fail", "appLabel": "youdid.wtf", "mbuiEnv": "MBUI_UPDATE_FEED=android;MBUI_BETA=1;MBUI_OWN=1"}
    },
    "monoid": {
      "applicationId": "build.monoid.android",
      "minify": true,
      "res": ["app/src/stable/res", "app/src/monoid/res"],
      "placeholders": {"appHost": "app.monoid.build", "appLabel": "monoid", "mbuiEnv": "MBUI_UPDATE_FEED=android;MBUI_OWN=1;MBUI_CLOUD=https://app.monoid.build;MBUI_PRODUCT=monoid"}
    },
    "monoid-beta": {
      "applicationId": "build.monoid.android.beta",
      "minify": true,
      "res": ["app/src/beta/res", "app/src/monoid/res"],
      "placeholders": {"appHost": "app.monoid.build", "appLabel": "monoid.zone", "mbuiEnv": "MBUI_UPDATE_FEED=android;MBUI_BETA=1;MBUI_OWN=1;MBUI_CLOUD=https://app.monoid.build;MBUI_PRODUCT=monoid"}
    },
    "debug": {
      "applicationId": "fail.still.android.dev",
      "debuggable": true,
      "placeholders": {"appHost": "app.still.fail", "appLabel": "still.fail dev", "mbuiEnv": ""}
    }
  }
}
