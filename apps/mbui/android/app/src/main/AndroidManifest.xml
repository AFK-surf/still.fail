<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- images from http(s) URLs -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- mbui's NetworkWatch: the default network as it changes, told to the core (client.wake {network}: src/sfapp/app.mbt) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- mbui's MainActivity holds a multicast lock while on screen: the core's mDNS hears a station on the LAN answer -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- LoginService: the app held up while a loopback listener waits for the browser (BrowserLogin, the core's listen.*) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 共享调试 lent again for chats' grants as the phone starts again (AdbBoot) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- the system's notifications (mbui's Notices: a chat's notices, as still.fail's Android app shows them) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 共享调试 (AdbShare.java): Wireless debugging turned on by the app itself, once the station's adb granted it
         (adb.grant): pm grant takes only what is asked for here. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- mbui's Updates: a newer build of the app handed to the system's installer (the person agrees) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- mbui's Updates: the app's own newer build installed without the system asking the person each time (Android 12+:
         PackageInstaller USER_ACTION_NOT_REQUIRED takes effect only with this) -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- CoreHost's secure.* (a secret's use allowed, the workspace's lock): the system's BiometricPrompt asks the person
         (biometrics or the screen lock), which no library's manifest brings in: the app's own to ask for -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- ＋'s recent photos and videos (mbui's Gallery.java, as still.fail's Attach.kt): the gallery's, all or those chosen -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- androidx.core's own (its manifest's, merged here: apk.json "merged") -->
    <permission android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />
    <!-- BrowserLogin asks whether there is a browser to open a login page in -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>
    <!-- Not backed up (as still.fail's app): the core's data and sealed files restored elsewhere would not match this
         device's Keystore keys. Plain HTTP to a local still.fail alone (xml/local_network.xml). -->
    <application android:name=".StillfailApp" android:label="${appLabel}" android:icon="@mipmap/ic_launcher" android:hasCode="true" android:enableOnBackInvokedCallback="true" android:allowBackup="false" android:networkSecurityConfig="@xml/local_network" android:theme="@style/Theme.StillFail">
        <!-- singleTask, as still.fail's: coming back (BrowserLogin, or the page's link) closes the Custom Tab above it -->
        <activity android:name=".MainActivity" android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection|colorMode|touchscreen|mcc|mnc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A browser login's page, once the browser has come back, links here: <package>://back (the build's own package) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" android:host="back" />
            </intent-filter>
            <!-- still.fail's links, as still.fail's Android app takes them (apps/android/app/src/main/AndroidManifest.xml):
                 an item's link (a session's link in Slack), verified by still.fail cloud's assetlinks.json (served on both
                 hosts: app.still.fail, and ember.3720.org from before the rename), which lists this app's package; mbui's
                 Notices keeps the link for the app (@hostapi.link_opened), which asks the core what it opens (src/sfapp/links.mbt). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.still.fail" android:pathPrefix="/o/" />
                <data android:scheme="https" android:host="ember.3720.org" android:pathPrefix="/o/" />
            </intent-filter>
            <!-- An invitation's link (/invite#<token>), a chat's link as chats refer to each other (/w/<ws>/s/<station>/chats/<key>),
                 a station's 共享调试 an agent asks for (/w/<ws>/s/<station>/adb), one of its screens an agent asks a person to
                 take over (/w/<ws>/s/<station>/screen/<id>), and a login an agent started there (/w/<ws>/s/<station>/login/<id>). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.still.fail" android:path="/invite" />
                <data android:scheme="https" android:host="app.still.fail" android:pathPattern="/w/.*/s/.*/chats/.*" />
                <data android:scheme="https" android:host="app.still.fail" android:pathPattern="/w/.*/s/.*/adb" />
                <data android:scheme="https" android:host="app.still.fail" android:pathPattern="/w/.*/s/.*/screen/.*" />
                <data android:scheme="https" android:host="app.still.fail" android:pathPattern="/w/.*/s/.*/login/.*" />
                <data android:scheme="https" android:host="ember.3720.org" android:path="/invite" />
                <data android:scheme="https" android:host="ember.3720.org" android:pathPattern="/w/.*/s/.*/chats/.*" />
                <data android:scheme="https" android:host="ember.3720.org" android:pathPattern="/w/.*/s/.*/adb" />
                <data android:scheme="https" android:host="ember.3720.org" android:pathPattern="/w/.*/s/.*/screen/.*" />
                <data android:scheme="https" android:host="ember.3720.org" android:pathPattern="/w/.*/s/.*/login/.*" />
            </intent-filter>
        </activity>
        <!-- What another app shares (a link, some text, files: the system's share sheet), into a chat (mbui's Shares.java):
             a sheet over that app (mbui's OverActivity, as still.fail's ShareActivity), in a task of its own and out of the
             recent apps, so going back lands where the person was. -->
        <activity android:name=".OverActivity" android:exported="true"
            android:theme="@style/Theme.StillFail.Share"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection|colorMode|touchscreen|mcc|mnc">
            <!-- What another app shares (a link, some text, files: the system's share sheet), into a chat (mbui's Shares.java) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- mbui's Shares: a file handed to another app, read only (the cache's shared/) -->
        <provider android:name=".Shares$Files" android:authorities="${applicationId}.shared" android:exported="false" android:grantUriPermissions="true" />
        <!-- mbui's Updates: what the installer says of a newer build handed to it -->
        <receiver android:name=".Updates$InstallResult" android:exported="false" />
        <!-- the app's environment's defaults (mbui's MainActivity): the release's update feed (build.gradle.kts) -->
        <meta-data android:name="dev.mbui.env" android:value="${mbuiEnv}" />
        <!-- what shows under the system bars, light and dark (mbui's MainActivity): the page's paper (src/sf tokens) -->
        <meta-data android:name="dev.mbui.ground" android:value="#F5F3EF,#1B1C1F" />
        <meta-data android:name="dev.mbui.edge" android:value="true" />
        <!-- The core's JS sampled for a while, asked from adb (CoreProfileReceiver.java): the shell holds DUMP, apps do not. -->
        <receiver android:name=".CoreProfileReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <service android:name=".LoginService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Keeps a local loopback listener alive for a few minutes while the user signs in in their browser, so the browser's OAuth redirect to 127.0.0.1 reaches the app." />
        </service>
        <!-- The phone started again, the app updated: lent again for the chats' grants live as it went (AdbBoot). -->
        <receiver android:name=".AdbBoot" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- This phone's adb lent to a station's agents (AdbShare.java): held up meanwhile, saying so. -->
        <service android:name=".AdbShareService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Lends this phone's own adb (Wireless debugging) to the user's coding agents over the app's connection, while the user shares it." />
        </service>
        <!-- The app's keyboard, for typing in any app (mbui's Keyboard.java; src/keyboard): in a process of its own, the
             keyboard's program apart from the app's (StillfailApp starts nothing of the app's there). -->
        <service
            android:name=".Keyboard"
            android:label="${appLabel}"
            android:exported="true"
            android:process=":keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/keyboard" />
        </service>
        <!-- Reads the Wireless debugging pairing dialog's code off Settings while 共享调试 pairs (AdbCodeReader.java), once
             the person turns it on in Accessibility; only the system binds it. -->
        <service
            android:name=".AdbCodeReader"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/adb_code_reader" />
        </service>
        <!-- FCM's pushes (Push.java), as still.fail's Android app has them: Firebase set up by hand from the app's
             resources (no google-services.json), so neither its start-up provider (FirebaseInitProvider) nor a token
             before the app asks for one. What the Firebase and Play services libraries' manifests add, merged here as
             Gradle merges them (apk.json "merged": firebase-messaging, -common, -installations, -datatransport,
             datatransport's runtime and CCT backend, play-services-basement; androidx.startup and profileinstaller's
             initializers left out). -->
        <service android:name=".Push$Service" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <receiver android:name="com.google.firebase.iid.FirebaseInstanceIdReceiver" android:exported="true"
            android:permission="com.google.android.c2dm.permission.SEND">
            <intent-filter>
                <action android:name="com.google.android.c2dm.intent.RECEIVE" />
            </intent-filter>
            <meta-data android:name="com.google.android.gms.cloudmessaging.FINISHED_AFTER_HANDLED" android:value="true" />
        </receiver>
        <service android:name="com.google.firebase.messaging.FirebaseMessagingService" android:directBootAware="true"
            android:exported="false">
            <intent-filter android:priority="-500">
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service android:name="com.google.firebase.components.ComponentDiscoveryService" android:directBootAware="true"
            android:exported="false">
            <meta-data android:name="com.google.firebase.components:com.google.firebase.FirebaseCommonKtxRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
            <meta-data android:name="com.google.firebase.components:com.google.firebase.datatransport.TransportRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
            <meta-data android:name="com.google.firebase.components:com.google.firebase.installations.FirebaseInstallationsKtxRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
            <meta-data android:name="com.google.firebase.components:com.google.firebase.installations.FirebaseInstallationsRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
            <meta-data android:name="com.google.firebase.components:com.google.firebase.messaging.FirebaseMessagingKtxRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
            <meta-data android:name="com.google.firebase.components:com.google.firebase.messaging.FirebaseMessagingRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
        </service>
        <service android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery" android:exported="false">
            <meta-data android:name="backend:com.google.android.datatransport.cct.CctBackendFactory" android:value="cct" />
        </service>
        <service android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
            android:exported="false" />
        <meta-data android:name="com.google.android.gms.version" android:value="@integer/google_play_services_version" />
        <!-- Folds: Jetpack WindowManager reads the device's fold through what the system provides it, as its library's
             manifest asks (apk.json "merged": androidx.window:window) -->
        <uses-library android:name="androidx.window.extensions" android:required="false" />
        <uses-library android:name="androidx.window.sidecar" android:required="false" />
    </application>
</manifest>
