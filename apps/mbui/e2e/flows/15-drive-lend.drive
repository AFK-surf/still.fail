# 文件 (pushed over Home: MBUI_OPEN_PAGE=files, the bottom bar's place until there is one): the station's home, ＋ lends
# another folder through the folder picker (the station's home, its folders), this run's own e2e-{T}.
#env MBUI_OPEN_PAGE=files
timeout 90000
until 主目录
shot 1-files
tap icon:plus
until 选择文件夹
until e2e-{T}
shot 2-picker
tap e2e-{T}
until 子文件夹
until =选择此文件夹
tap =选择此文件夹
until 已开放「e2e-{T}」
until =e2e-{T}
shot 3-lent
