check "the reader read the file through the core (drive.read)" 'grep -q "ANSWER drive.read ok" $OUT/17-drive-read.log'
check "where it was left was told to the core (drive.place) past the first two chapters" 'grep "CALL drive.place" $OUT/17-drive-read.log | tail -1 | python3 -c "import sys,json; l=sys.stdin.read(); p=json.loads(l[l.index(\"{\"):]); t=open(\"$DRIVE/小说-e2e.txt\").read(); assert p[\"at\"] >= t.index(\"第三章\") - 200, p"'
check "the core keeps the place on the device" 'core_has "小说-e2e.txt"'
