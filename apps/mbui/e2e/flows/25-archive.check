# (an archived chat's entries leave the station's live tables: it is found by the session the app archived)
S18=$(grep '^CALL chat.archive' $OUT/$name.log | tail -1 | sed 's/.*"session":"\([^"]*\)".*/\1/')
check "the app asked for that chat's session" '[ -n "$S18" ] && [ "$S18" != "$(python3 -c "import json; print(json.load(open(\"$WORK/peer/chat.json\"))[\"session\"])")" ]'
check "the station has it archived, by hand" '[ "$(sql "select archived_by from sessions where key = \"$S18\" and archived_at is not null")" = manual ]'
check "and its thread put away" '[ "$(sql "select t.hidden_by from threads t where t.home = \"$S18\" and t.hidden_at is not null")" = manual ]'
check "the test chat is not" '[ -z "$(sql "select t.hidden_at from threads t join entries e on e.thread = t.id where e.n = 1 and e.text like \"端到端测试%\" and t.hidden_at is not null")" ]'
