# Settings → Station → the test station's page → "…" → 重命名: the new name in the bar and the list at once; still.fail
# cloud says it too (alice's other device reads the workspace: STATION e2e-<run>); named back after.
timeout 90000
until 端到端测试
tap icon:settings
until =Station
tap =Station
until =studio
shot 1-stations
tap =studio
until 在此 station 上
shot 2-station
tap icon:more
until 重命名
tap 重命名
until station 名称
clear
type e2e-{T}
tap =保存
until =e2e-{T}
shot 3-renamed
log do: peer station-name e2e-{T}
# (the other device reads the name from still.fail cloud: the command beside the run, done before it is named back)
wait 25000
tap icon:more
until 重命名
tap 重命名
until station 名称
clear
type studio
tap =保存
until =studio
shot 4-named-back
