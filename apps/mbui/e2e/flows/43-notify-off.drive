# Settings → 通知 switched off (notify.set; the core takes this device's pushes off the accounts): a card asked on the
# other device then shows no notice; switched on again.
timeout 60000
until 端到端测试
tap icon:settings
until Workspace
drag 195 600 0 -400 400
until =通知
tap =通知
until 不接收通知
shot 1-off
back
until 端到端测试
log do: peer send 关了通知 {T} card:关着的时候 {T}|好 {T}|不好 {T}
timeout 150000
until 关着的时候 {T}
# (time for a notice that should not come to come: the core's, the system's)
wait 5000
nonotice 关着的时候 {T}
shot 2-home
timeout 60000
tap icon:settings
until Workspace
drag 195 600 0 -400 400
until =通知
tap =通知
until 任务完成、需要处理
shot 3-on
