check "the player read the video through the core (drive.read), a part at a time" 'grep -q "player: 第01集.mp4 @0 [0-9]* bytes through the core (drive.read" $OUT/$name.log && [ $(grep -c "ANSWER drive.read ok" $OUT/$name.log) -ge 2 ]'
check "the system's player showed its frames" 'grep -q "player: 第01集.mp4 ready" $OUT/$name.log && grep -q "view [0-9]*: first frame shown" $OUT/$name.log && python3 $D/pngstat.py $OUT/$name/3-later.png 0.1 0.4 0.9 0.6 20'
check "the subtitle beside it was read and shown" 'grep -q "player: subtitle 第01集.srt: 2 lines" $OUT/$name.log'
check "where it was left was told to the core (drive.place), a few seconds of 20; the core keeps it on the device" 'grep "CALL drive.place" $OUT/$name.log | grep "第01集.mp4" | python3 -c "import sys,json; ps=[json.loads(l[l.index(\"{\"):]) for l in sys.stdin]; assert any(2000 <= p[\"at\"] <= 14000 and 19000 <= p[\"of\"] <= 21000 for p in ps), ps" && core_has "第01集.mp4"'
check "opened again, it played on from where it was left" 'grep "player: open 第01集.mp4" $OUT/$name.log | sed -n 2p | grep -q "from \([2-9][0-9][0-9][0-9]\|1[0-4][0-9][0-9][0-9]\) ms"'
check "15 s on took it to its end, kept as seen; the next one played in its place, through the core" 'grep "CALL drive.place" $OUT/$name.log | grep "第01集.mp4" | tail -1 | python3 -c "import sys,json; l=sys.stdin.read(); p=json.loads(l[l.index(\"{\"):]); assert p[\"at\"] >= p[\"of\"] - 600, p" && grep -q "player: 第02集.mp4 @0 [0-9]* bytes through the core (drive.read" $OUT/$name.log && grep -q "player: 第02集.mp4 ready" $OUT/$name.log'
check "the song played, read through the core, with no picture" 'grep -q "player: open 片尾曲.m4a (audio/" $OUT/$name.log && grep -q "player: 片尾曲.m4a ready" $OUT/$name.log && python3 $D/pngstat.py $OUT/$name/7-song.png 0.3 0.42 0.7 0.5 3'
check "the station's folder has what was played, as it was" '[ -s "$DRIVE/影音/第01集.mp4" ] && [ -s "$DRIVE/影音/第01集.srt" ]'
