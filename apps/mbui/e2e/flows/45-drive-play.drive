# A video of the drive played (the player: Player.kt): 影音 put in the lent folder before the app starts (drive-media),
# the first episode tapped: the player, which of the folder's it is (2 / 3: the song sorts first), its subtitle's words at
# their time, its picture through the core a part at a time (drive.read); left at about 3 s, where it was is kept; opened
# again it plays on from there; 15 s on, twice, takes it to its end (播放结束), the next one offered and tapped (in place: 3 / 3);
# back on the folder, the song: its mark and name, no picture.
#env MBUI_OPEN_PAGE=files
#before drive-media {T}
timeout 90000
until =e2e-{T}
tap =e2e-{T}
until 影音
tap 影音
until 第01集.mp4
until 片尾曲.m4a
shot 1-folder
tap 第01集.mp4
# (a video playing moves on its own, never settled: what is looked at and done while it plays is `now`)
now until 2 / 3
now until 第一句字幕
now shot 2-playing
now until 0:03
now shot 3-later
now back
until 第02集.mp4
tap 第01集.mp4
now until 2 / 3
now until / 0:20
now shot 4-resumed
now tap icon:forward-15
# (the system's player takes the first seek before the second)
wait 500
now tap icon:forward-15
until 播放结束
until 下一个：第02集.mp4
shot 5-ended
tap 下一个：第02集.mp4
now until 3 / 3
now until / 0:04
# (it plays on, in real time: its frames for the shot)
wait 1500
now shot 6-next
now back
until 片尾曲.m4a
tap 片尾曲.m4a
now until 1 / 3
now until 0:01
now shot 7-song
now back
until 片尾曲.m4a
