check "the core found the newer build in still.fail cloud's feed (app.update)" 'grep -q "CALL app.update .*\"platform\":\"android\"" $OUT/$name.log && grep -q "update: 0.1.1 (2) is newer than this build (1)" $OUT/$name.log'
check "it was downloaded whole from the cloud, its sha256 as the feed says" '$ADB logcat -d -s mbui:I > $OUT/$name/logcat.txt; sum=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1]))[\"sha256\"])" $WORK/ember/dist/releases/android/latest.json) && grep -q "update: stillfail-2.apk downloaded ([0-9]* bytes), sha256 $sum" $OUT/$name/logcat.txt'
check "handed to the system's installer, which asks the person to confirm (its page in front)" '$ADB logcat -d -s mbui:I > $OUT/$name/logcat.txt; cp $WORK/run/installer.png $OUT/$name/2-installer.png && grep -q "update: stillfail-2.apk handed to the system" $OUT/$name/logcat.txt && grep -q "update: the installer asks the person to confirm" $OUT/$name/logcat.txt && grep -q "^RUNNER done 1-android-installer: ok" $OUT/$name.log'
