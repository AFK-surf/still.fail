check "the core found the newer build in still.fail cloud's feed (app.update)" 'grep -q "CALL app.update .*\"platform\":\"android\"" $OUT/$name.log && grep -q "update: 0.1.1 (2) is newer than this build (1)" $OUT/$name.log'
check "it was made from the feed's delta and the installed APK (inflated, patched, deflated again on the device), its sha256 as the feed says, not downloaded whole" '$ADB logcat -d -s mbui:I > $OUT/$name/logcat.txt; f=$WORK/stillfail/dist/releases/android/latest.json; sum=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1]))[\"sha256\"])" $f) && dsize=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1]))[\"deltas\"][0][\"size\"])" $f) && grep -q "update: stillfail-2.apk made from a delta of $dsize bytes (in [0-9]* ms), sha256 $sum as the feed says" $OUT/$name/logcat.txt && ! grep -q "update: the delta for stillfail-2.apk not used" $OUT/$name/logcat.txt && ! grep -q "update: stillfail-2.apk downloaded" $OUT/$name/logcat.txt'
check "handed to the system's installer, which asks the person to confirm (its page in front)" '$ADB logcat -d -s mbui:I > $OUT/$name/logcat.txt; cp $WORK/run/installer.png $OUT/$name/2-installer.png && grep -q "update: stillfail-2.apk handed to the system" $OUT/$name/logcat.txt && grep -q "update: the installer asks the person to confirm" $OUT/$name/logcat.txt && grep -q "^RUNNER done 1-android-installer: ok" $OUT/$name.log'
