# A drive sheet let go of: a row held, ⋯ → its sheet, the scrim tapped; 重命名 tapped where it is drawn as the sheet
# goes down is nothing (no rename asked); the file keeps its name at the station.
#env MBUI_OPEN_PAGE=files
timeout 90000
until =e2e-{T}
tap =e2e-{T}
until 说明.txt
hold 900 说明.txt
until 已选 1 项
tap icon:more
until 重命名
shot 1-sheet
tapxy 195 100
# (40 ms into the sheet's going down: 重命名 tapped where it is only drawn)
wait 40
now shot 2-closing
now tapxy 60 -150
now tapxy 60 -100
now tapxy 60 -60
gone =保存
gone 重命名
shot 3-closed
