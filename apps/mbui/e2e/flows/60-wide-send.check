check "the station has the message, once, as alice's" '[ "$(sql "select count(*) from entries where author_kind=\"person\" and author=\"alice@example.test\" and text=\"宽屏里发出的消息 $TAG\"")" = 1 ]'
check "it went to the test chat (its thread)" '[ "$(sql "select count(*) from entries e join entries f on e.thread = f.thread where e.text = \"宽屏里发出的消息 $TAG\" and f.text like \"端到端测试的对话%\"")" -ge 1 ]'
