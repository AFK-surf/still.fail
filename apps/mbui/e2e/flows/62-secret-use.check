check "the agent ran its command with the token granted (the variable set, its value never shown)" 'sql "select text from entries where author_kind=\"agent\" and text like \"用密钥跑完了%\"" | grep -q "have:yes"'
check "the agent never saw the token's value" '! sql "select text from entries" | grep -q "e2e-secret-0123456789"'
