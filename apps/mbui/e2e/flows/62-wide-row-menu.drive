#env MBUI_WIN=1280x800
# A chat's row right clicked in the wide frame's list: its menu (Sidebar.tsx ContextMenu); 固定 pins it (chat.pin), the
# row goes up under 已固定; right clicked again, 取消固定 lets it go.
timeout 60000
until 新建对话
until 端到端测试
hover 端到端测试
wait 500
shot 1-hover
rightclick 端到端测试
until =固定
wait 400
shot 2-menu
tap =固定
gone =重命名
until 已固定
log do: pins
wait 2000
shot 3-pinned
rightclick 端到端测试
until =取消固定
wait 400
shot 4-menu-pinned
tap =取消固定
gone 已固定
log do: pins
wait 2000
