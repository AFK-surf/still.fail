check "the station has alice's answer, quoting the post" 'sql "select quotes from entries where author_kind=\"person\" and author=\"alice@example.test\" and text like \"%橙色 $TAG%\" and text not like \"%card:%\"" | grep -q "按钮用什么颜色 $TAG"'
check "the second card let go: dismissed has alice's row for it, nothing answered" '[ "$(sql "select count(*) from dismissed d join entries e on e.thread = d.thread and e.n = d.n where e.text = \"先做哪一页 $TAG\"")" -ge 1 ] && [ "$(sql "select count(*) from entries where author_kind=\"person\" and (text like \"%首页 $TAG%\" or text like \"%设置页 $TAG%\") and text not like \"%card:%\"")" = 0 ]'
check "the options went as the Android app's do (the motion log: fading to 90%, their room closing)" 'grep "MOTION .* under/options/" $OUT/$name.log | grep -q "scale=0.9[0-9]*$\|scale=0.9[0-9]* " && grep "MOTION .* under/options/" $OUT/$name.log | grep -q "open=0\.[0-4]"'
check "how it went came in their place (the motion log: the line's room opening)" 'grep -q "MOTION .* under/outcome/.* open=0\.[1-9]" $OUT/$name.log'
check "忽略 went on ArchiveEase's 280 ms (the motion log: to 85%, its room closing)" 'grep "MOTION .* under/dismiss/" $OUT/$name.log | grep -q "scale=0.8[5-9]"'
