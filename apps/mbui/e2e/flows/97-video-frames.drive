# A video's frames (VideoViewer.kt): its frames' times read from the file (4 s at 30 a second: 120 frames), ‹ and ›
# to the one before and the very next, 保存此帧: the frame showing kept with the downloads as a PNG at its own size.
#env MBUI_VIEWER_AWAKE=1
timeout 60000
until 端到端测试
log do: peer createfiles 一段视频 {T} post:收到视频 {T} -- e2e-clip.mp4
timeout 180000
until 一段视频 {T}
timeout 60000
wait 1000
tap 一段视频 {T}
until =studio
timeout 120000
until e2e-clip.mp4
tap e2e-clip.mp4
until / 120 帧
shot 1-frames
# wherever it plays to meanwhile (on a slow device, its end: its frames are read as it plays), ‹ pauses on the frame
# before the one showing, › on the very next: frame-exact both ways
tap icon:chevron-left
wait 1000
tap icon:chevron-left
wait 1000
tap icon:chevron-right
wait 1000
shot 2-stepped
tap icon:camera
until 已保存到「下载」
shot 3-saved
