<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- images from http(s) URLs -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- LoginService: the app held up while a loopback listener waits for the browser (BrowserLogin, the core's listen.*) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- the system's notifications (Notices: a chat's notices, as still.fail's Android app shows them) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Updates: a newer build of the app handed to the system's installer (the person agrees) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- mbui's Updates: the app's own newer build installed without the system asking the person each time (Android 12+:
         PackageInstaller USER_ACTION_NOT_REQUIRED takes effect only with this) -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- BrowserLogin asks whether there is a browser to open a login page in -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>
    <application android:label="MoonBit UI" android:hasCode="true" android:enableOnBackInvokedCallback="true" android:usesCleartextTraffic="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- singleTask, as still.fail's: coming back (BrowserLogin, or the page's link) closes the Custom Tab above it -->
        <activity android:name=".MainActivity" android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection|colorMode|touchscreen|mcc|mnc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- What another app shares (a link, some text, files: the system's share sheet), into a chat (Shares.java) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- A browser login's page, once the browser has come back, links here: <package>://back -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" android:host="back" />
            </intent-filter>
        </activity>
        <!-- Shares: a file handed to another app, read only (the cache's shared/) -->
        <provider android:name=".Shares$Files" android:authorities="${applicationId}.shared" android:exported="false" android:grantUriPermissions="true" />
        <!-- Updates: what the installer says of a newer build handed to it -->
        <receiver android:name=".Updates$InstallResult" android:exported="false" />
        <service android:name=".LoginService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Keeps a local loopback listener alive for a few minutes while the user signs in in their browser, so the browser's OAuth redirect to 127.0.0.1 reaches the app." />
        </service>
        <!-- Folds: Jetpack WindowManager reads the device's fold through what the system provides it, as its library's
             manifest asks (apk.json "merged": androidx.window:window) -->
        <uses-library android:name="androidx.window.extensions" android:required="false" />
        <uses-library android:name="androidx.window.sidecar" android:required="false" />
    </application>
</manifest>
