diff --git a/src/signals/trace.c b/src/signals/trace.c
new file mode 100644
index 000000000..890440940
--- /dev/null
+++ b/src/signals/trace.c
@@ -0,0 +1,20 @@
+// bench/signals/record: the trace's lines appended to MBUI_SIGNALS_TRACE (none when it is not set).
+#include <stdio.h>
+#include <stdlib.h>
+#include "moonbit.h"
+
+static FILE *trace_file = NULL;
+static int trace_opened = 0;
+
+void mbui_signals_trace_line(moonbit_string_t s) {
+  if (!trace_opened) {
+    trace_opened = 1;
+    const char *p = getenv("MBUI_SIGNALS_TRACE");
+    if (p && *p) trace_file = fopen(p, "w");
+  }
+  if (!trace_file) return;
+  int32_t n = Moonbit_array_length(s);
+  for (int32_t i = 0; i < n; i++) fputc((char)s[i], trace_file);
+  fputc('\n', trace_file);
+  if (n == 1 && s[0] == 'F') fflush(trace_file);
+}
diff --git a/src/signals/trace.mbt b/src/signals/trace.mbt
new file mode 100644
index 000000000..da7b9eff3
--- /dev/null
+++ b/src/signals/trace.mbt
@@ -0,0 +1,37 @@
+// bench/signals/record: every call of the app's into the signals written down, a line each, to the file
+// MBUI_SIGNALS_TRACE names (trace.c), for bench/signals' replay. Never in still.fail's own build: record.sh applies it
+// to a copy.
+
+///|
+#borrow(line)
+extern "C" fn trace_line(line : String) -> Unit = "mbui_signals_trace_line"
+
+///|
+let trace_ids : Ref[Int] = { val: 0 }
+
+///|
+fn trace_new_id() -> Int {
+  trace_ids.val += 1
+  trace_ids.val
+}
+
+///|
+fn trace0(op : String) -> Unit {
+  trace_line(op)
+}
+
+///|
+fn trace1(op : String, a : Int) -> Unit {
+  trace_line("\{op} \{a}")
+}
+
+///|
+fn trace2(op : String, a : Int, b : Int) -> Unit {
+  trace_line("\{op} \{a} \{b}")
+}
+
+///|
+/// A frame begins (kept_part.mbt's clock_frame_start).
+pub fn trace_frame() -> Unit {
+  trace_line("F")
+}
