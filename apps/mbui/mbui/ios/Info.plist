  <key>NSPhotoLibraryUsageDescription</key><string>The gallery's recent photos, to pick from.</string>
  <key>NSCameraUsageDescription</key><string>A photo taken now, to pick.</string>
  <key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key><true/>
