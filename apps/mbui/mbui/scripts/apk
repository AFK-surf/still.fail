#!/bin/sh
# An Android app's APK without Gradle (tools/apk, in MoonBit; its main.mbt says how): apk lock APP.json | apk build
# APP.json --variant V --version-code N --version-name S --out APK [--abi A] [--keystore K] | apk fetch PATH SHA256.
# Built here only when there is none built from these very sources (by content).
D=$(cd "$(dirname "$0")" && pwd)
T=$D/../tools
TOOLS_SCRIPTS=$D; . "$D/tooltarget.sh"
B=$T/_build/$TT/release/build/apk/apk.$TX
src=$(cd "$T" && find apk sys re rjson moon.mod moon.work -type f | LC_ALL=C sort | xargs cat | cksum)
# (`key`: what it is built from, said: the key CI keeps the tool by, .github/actions/mbui-moonbit)
[ "${1:-}" != key ] || { echo "$src" | tr ' ' -; exit 0; }
if [ ! -f "$B" ] || [ "$(cat "$B.src" 2>/dev/null)" != "$src" ]; then
  (cd "$T" && env -u MOON_CC moon build --target $TT --release apk >&2) || { echo "apk: tools/apk did not build" >&2; exit 1; }
  echo "$src" > "$B.src"
fi
APK_HOME=$D tool_exec "$B" "$@"
