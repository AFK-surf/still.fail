#!/bin/sh
# mbui's small checks and filters (tools/chk, in MoonBit; its main.mbt says each): chk errs, chk corner-sl [--check],
# chk outside-kinds [HOST…], chk textrec …. Built here only when there is none built from these very sources (by
# content).
D=$(cd "$(dirname "$0")" && pwd)
T=$D/../tools
TOOLS_SCRIPTS=$D; . "$D/tooltarget.sh"
B=$T/_build/$TT/release/build/chk/chk.$TX
src=$(cd "$T" && find chk png sys re rjson moon.mod moon.work -type f | LC_ALL=C sort | xargs cat | cksum)
# (`key`: what it is built from, said: the key CI keeps the tool by, .github/actions/mbui-moonbit)
[ "${1:-}" != key ] || { echo "$src" | tr ' ' -; exit 0; }
if [ ! -f "$B" ] || [ "$(cat "$B.src" 2>/dev/null)" != "$src" ]; then
  (cd "$T" && env -u MOON_CC moon build --target $TT --release chk >&2) || { echo "chk: tools/chk did not build" >&2; exit 1; }
  echo "$src" > "$B.src"
fi
CHK_HOME=$D tool_exec "$B" "$@"
