#!/bin/sh
# The native host's calls made Wasm's (tools/wasmhost, in MoonBit: its main.mbt says how): wasmhost gen|check
# THUNKS.c FILE.mbt…. Built here only when there is none built from these very sources (by content).
D=$(cd "$(dirname "$0")" && pwd)
T=$D/../tools
TOOLS_SCRIPTS=$D; . "$D/tooltarget.sh"
B=$T/_build/$TT/release/build/wasmhost/wasmhost.$TX
src=$(cd "$T" && find wasmhost sys moon.mod moon.work -type f | LC_ALL=C sort | xargs cat | cksum)
if [ ! -f "$B" ] || [ "$(cat "$B.src" 2>/dev/null)" != "$src" ]; then
  (cd "$T" && env -u MOON_CC moon build --target $TT --release wasmhost >&2) || { echo "wasmhost: tools/wasmhost did not build" >&2; exit 1; }
  echo "$src" > "$B.src"
fi
tool_exec "$B" "$@"
