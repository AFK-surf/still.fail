///|
test "absolute_layout_column_reverse_margin_border" {
  let root = @flex.Node::new()
  root.style.position = Absolute
  root.style.width = Pt(200.0)
  root.style.height = Pt(200.0)
  root.style.direction = ColumnReverse
  let root_child0 = @flex.Node::new()
  root_child0.style.position = Absolute
  root_child0.style.width = Pt(50.0)
  root_child0.style.height = Pt(50.0)
  root_child0.style.inset.left = Pt(5.0)
  root_child0.style.inset.right = Pt(3.0)
  root_child0.style.margin.right = Pt(4.0)
  root_child0.style.margin.left = Pt(3.0)
  root_child0.style.border.right = Pt(7.0)
  root_child0.style.border.left = Pt(1.0)
  root.add(root_child0)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 200.0, 200.0)
  check("root_child0", root_child0, 8.0, 150.0, 50.0, 50.0)
}
