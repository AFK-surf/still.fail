  root_child2.style.width = Pt(50.0)
  root.add(root_child2)
  let root_child3 = @flex.Node::new()
  root_child3.style.width = Pt(50.0)
  root.add(root_child3)
  let root_child4 = @flex.Node::new()
  root_child4.style.width = Pt(50.0)
  root.add(root_child4)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 150.0, 100.0)
  check("root_child0", root_child0, 0.0, 0.0, 50.0, 90.0)
  check("root_child1", root_child1, 50.0, 0.0, 50.0, 90.0)
  check("root_child2", root_child2, 100.0, 0.0, 50.0, 90.0)
  check("root_child3", root_child3, 0.0, 90.0, 50.0, 10.0)
  check("root_child4", root_child4, 50.0, 90.0, 50.0, 10.0)
}

///|
