  root_child0.style.margin.right = Pt(20.0)
  root.add(root_child0)
  let root_child1 = @flex.Node::new()
  root_child1.style.direction = Row
  root_child1.style.wrap = Wrap
  root_child1.style.shrink = 1.0
  root_child1.style.grow = 1.0
  root_child1.style.align_content = Stretch
  root.add(root_child1)
  let root_child1_child0 = @flex.Node::new()
  root_child1_child0.style.height = Pt(30.0)
  root_child1_child0.style.width = Pt(30.0)
  root_child1_child0.style.margin.right = Pt(20.0)
  root_child1.add(root_child1_child0)
  let root_child1_child1 = @flex.Node::new()
  root_child1_child1.style.height = Pt(30.0)
  root_child1_child1.style.width = Pt(30.0)
  root_child1_child1.style.margin.right = Pt(20.0)
  root_child1.add(root_child1_child1)
  let root_child1_child2 = @flex.Node::new()
  root_child1_child2.style.height = Pt(30.0)
  root_child1_child2.style.width = Pt(30.0)
  root_child1_child2.style.margin.right = Pt(20.0)
  root_child1.add(root_child1_child2)
  let root_child1_child3 = @flex.Node::new()
  root_child1_child3.style.height = Pt(30.0)
  root_child1_child3.style.width = Pt(30.0)
  root_child1_child3.style.margin.right = Pt(20.0)
  root_child1.add(root_child1_child3)
  let root_child1_child4 = @flex.Node::new()
  root_child1_child4.style.height = Pt(30.0)
  root_child1_child4.style.width = Pt(30.0)
  root_child1_child4.style.margin.right = Pt(20.0)
  root_child1.add(root_child1_child4)
  let root_child2 = @flex.Node::new()
  root_child2.style.height = Pt(50.0)
  root_child2.style.width = Pt(50.0)
  root_child2.style.margin.left = Pt(20.0)
  root.add(root_child2)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 400.0, 140.0)
  check("root_child0", root_child0, 20.0, 20.0, 100.0, 100.0)
  check("root_child1", root_child1, 140.0, 20.0, 170.0, 100.0)
  check("root_child1_child0", root_child1_child0, 0.0, 0.0, 30.0, 30.0)
  check("root_child1_child1", root_child1_child1, 50.0, 0.0, 30.0, 30.0)
  check("root_child1_child2", root_child1_child2, 100.0, 0.0, 30.0, 30.0)
  check("root_child1_child3", root_child1_child3, 0.0, 50.0, 30.0, 30.0)
  check("root_child1_child4", root_child1_child4, 50.0, 50.0, 30.0, 30.0)
  check("root_child2", root_child2, 330.0, 20.0, 50.0, 50.0)
}

///|
test "align_content_stretch_and_align_items_flex_end_with_flex_wrap" {
  let root = @flex.Node::new()
  root.style.position = Absolute
  root.style.width = Pt(300.0)
  root.style.height = Pt(300.0)
  root.style.direction = Row
  root.style.wrap = Wrap
  root.style.align_content = Stretch
  root.style.align_items = FlexEnd
  let root_child0 = @flex.Node::new()
  root_child0.style.height = Pt(50.0)
  root_child0.style.width = Pt(150.0)
  root_child0.style.align_self = FlexStart
  root.add(root_child0)
  let root_child1 = @flex.Node::new()
  root_child1.style.height = Pt(100.0)
  root_child1.style.width = Pt(120.0)
  root.add(root_child1)
  let root_child2 = @flex.Node::new()
  root_child2.style.height = Pt(50.0)
  root_child2.style.width = Pt(120.0)
  root.add(root_child2)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 300.0, 300.0)
  check("root_child0", root_child0, 0.0, 0.0, 150.0, 50.0)
  check("root_child1", root_child1, 150.0, 75.0, 120.0, 100.0)
  check("root_child2", root_child2, 0.0, 250.0, 120.0, 50.0)
}

