  root_child0_child0.style.set_width(Pt(20.0))
  root_child0_child0.style.set_height(Pt(25.0))
  root_child0_child0.style.set_padding_left(Pt(3.0))
  root_child0_child0.style.set_padding_top(Pt(3.0))
  root_child0_child0.style.set_padding_right(Pt(3.0))
  root_child0_child0.style.set_padding_bottom(Pt(3.0))
  root_child0_child0.style.set_border_left(Pt(6.0))
  root_child0_child0.style.set_border_top(Pt(6.0))
  root_child0_child0.style.set_border_right(Pt(6.0))
  root_child0_child0.style.set_border_bottom(Pt(6.0))
  root_child0.add(root_child0_child0)
  let root_child0_child0_child0 = @flex.Node::new()
  root_child0_child0_child0.style.set_width(Pt(10.0))
  root_child0_child0_child0.style.set_height(Pt(5.0))
  root_child0_child0_child0.style.box_sizing = ContentBox
  root_child0_child0_child0.style.set_padding_left(Pt(1.0))
  root_child0_child0_child0.style.set_padding_top(Pt(1.0))
  root_child0_child0_child0.style.set_padding_right(Pt(1.0))
  root_child0_child0_child0.style.set_padding_bottom(Pt(1.0))
  root_child0_child0_child0.style.set_border_left(Pt(1.0))
  root_child0_child0_child0.style.set_border_top(Pt(1.0))
  root_child0_child0_child0.style.set_border_right(Pt(1.0))
  root_child0_child0_child0.style.set_border_bottom(Pt(1.0))
  root_child0_child0.add(root_child0_child0_child0)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 100.0, 100.0)
  check("root_child0", root_child0, 5.0, 5.0, 60.0, 60.0)
  check("root_child0_child0", root_child0_child0, 10.0, 10.0, 20.0, 25.0)
  check("root_child0_child0_child0", root_child0_child0_child0, 9.0, 9.0, 14.0, 9.0)
}

///|
test "box_sizing_border_box_flex_basis_row" {
  let root = @flex.Node::new()
  root.style.position = Absolute
  root.style.set_width(Pt(100.0))
  root.style.set_height(Pt(100.0))
  root.style.direction = Row
  let root_child0 = @flex.Node::new()
  root_child0.style.set_basis(Pt(50.0))
  root_child0.style.set_height(Pt(25.0))
  root_child0.style.set_padding_left(Pt(5.0))
  root_child0.style.set_padding_top(Pt(5.0))
  root_child0.style.set_padding_right(Pt(5.0))
  root_child0.style.set_padding_bottom(Pt(5.0))
  root_child0.style.set_border_left(Pt(10.0))
  root_child0.style.set_border_top(Pt(10.0))
  root_child0.style.set_border_right(Pt(10.0))
  root_child0.style.set_border_bottom(Pt(10.0))
  root.add(root_child0)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 100.0, 100.0)
  check("root_child0", root_child0, 0.0, 0.0, 50.0, 30.0)
}

