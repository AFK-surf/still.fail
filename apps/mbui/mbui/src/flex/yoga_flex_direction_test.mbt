  root_child0.add(root_child0_child2)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 100.0, 100.0)
  check("root_child0", root_child0, 0.0, 0.0, 100.0, 100.0)
  check("root_child0_child0", root_child0_child0, 90.0, 0.0, 10.0, 10.0)
  check("root_child0_child1", root_child0_child1, 90.0, 0.0, 10.0, 100.0)
  check("root_child0_child2", root_child0_child2, 80.0, 0.0, 10.0, 100.0)
}

///|
test "flex_direction_row_reverse_inner_padding_end" {
  let root = @flex.Node::new()
  root.style.position = Absolute
  root.style.set_height(Pt(100.0))
  root.style.set_width(Pt(100.0))
  let root_child0 = @flex.Node::new()
  root_child0.style.set_height(Pt(100.0))
  root_child0.style.set_width(Pt(100.0))
  root_child0.style.direction = RowReverse
  root.add(root_child0)
  let root_child0_child0 = @flex.Node::new()
  root_child0_child0.style.set_width(Pt(10.0))
  root_child0_child0.style.set_height(Pt(10.0))
  root_child0_child0.style.position = Absolute
  root_child0_child0.style.set_padding_right(Pt(10.0))
  root_child0.add(root_child0_child0)
  let root_child0_child1 = @flex.Node::new()
  root_child0_child1.style.set_width(Pt(10.0))
  root_child0.add(root_child0_child1)
  let root_child0_child2 = @flex.Node::new()
  root_child0_child2.style.set_width(Pt(10.0))
  root_child0.add(root_child0_child2)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 100.0, 100.0)
  check("root_child0", root_child0, 0.0, 0.0, 100.0, 100.0)
  check("root_child0_child0", root_child0_child0, 90.0, 0.0, 10.0, 10.0)
  check("root_child0_child1", root_child0_child1, 90.0, 0.0, 10.0, 100.0)
  check("root_child0_child2", root_child0_child2, 80.0, 0.0, 10.0, 100.0)
}

///|
test "flex_direction_alternating_with_percent" {
  let root = @flex.Node::new()
  root.style.position = Absolute
  root.style.set_height(Pt(300.0))
  root.style.set_width(Pt(200.0))
  let root_child0 = @flex.Node::new()
  root_child0.style.set_height(Pct(50.0))
  root_child0.style.set_width(Pct(50.0))
  root_child0.style.set_inset_left(Pct(10.0))
  root_child0.style.set_inset_top(Pct(10.0))
  root_child0.style.direction = Row
  root.add(root_child0)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 200.0, 300.0)
  check("root_child0", root_child0, 20.0, 30.0, 100.0, 150.0)
}
