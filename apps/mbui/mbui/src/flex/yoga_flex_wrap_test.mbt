  check("root", root, 0.0, 0.0, 0.0, 400.0)
  check("root_child0", root_child0, 0.0, 0.0, 0.0, 400.0)
}

///|
test "wrap_does_not_impose_min_cross_onto_single_flexline" {
  let root = @flex.Node::new()
  root.style.position = Absolute
  root.style.min_height = Pt(400.0)
  root.style.direction = Row
  root.style.wrap = Wrap
  let root_child0 = @flex.Node::new()
  root_child0.style.grow = 1.0
  root_child0.style.shrink = 1.0
  root_child0.style.basis = Pct(0.0)
  root.add(root_child0)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 0.0, 400.0)
  check("root_child0", root_child0, 0.0, 0.0, 0.0, 0.0)
}
