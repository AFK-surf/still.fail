  check("root", root, 0.0, 0.0, 700.0, 500.0)
  check("root_child0", root_child0, 250.0, 30.0, 100.0, 200.0)
  check("root_child1", root_child1, 200.0, 250.0, 200.0, 200.0)
  check("root_child2", root_child2, 420.0, 200.0, 100.0, 100.0)
}

///|
test "wrapped_column_max_height_flex" {
  let root = @flex.Node::new()
  root.style.position = Absolute
  root.style.height = Pt(500.0)
  root.style.width = Pt(700.0)
  root.style.align_items = Center
  root.style.justify = Center
  root.style.align_content = Center
  root.style.wrap = Wrap
  let root_child0 = @flex.Node::new()
  root_child0.style.width = Pt(100.0)
  root_child0.style.height = Pt(500.0)
  root_child0.style.max_height = Pt(200.0)
  root_child0.style.grow = 1.0
  root_child0.style.shrink = 1.0
  root_child0.style.basis = Pct(0.0)
  root.add(root_child0)
  let root_child1 = @flex.Node::new()
  root_child1.style.width = Pt(200.0)
  root_child1.style.height = Pt(200.0)
  root_child1.style.margin.left = Pt(20.0)
  root_child1.style.margin.top = Pt(20.0)
  root_child1.style.margin.right = Pt(20.0)
  root_child1.style.margin.bottom = Pt(20.0)
  root_child1.style.grow = 1.0
  root_child1.style.shrink = 1.0
  root_child1.style.basis = Pct(0.0)
  root.add(root_child1)
  let root_child2 = @flex.Node::new()
  root_child2.style.width = Pt(100.0)
  root_child2.style.height = Pt(100.0)
  root.add(root_child2)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 700.0, 500.0)
  check("root_child0", root_child0, 300.0, 0.0, 100.0, 180.0)
  check("root_child1", root_child1, 250.0, 200.0, 200.0, 180.0)
  check("root_child2", root_child2, 300.0, 400.0, 100.0, 100.0)
}

///|
test "wrap_nodes_with_content_sizing_overflowing_margin" {
  let root = @flex.Node::new()
  root.style.position = Absolute
  root.style.width = Pt(500.0)
  root.style.height = Pt(500.0)
  let root_child0 = @flex.Node::new()
  root_child0.style.direction = Row
  root_child0.style.wrap = Wrap
  root_child0.style.width = Pt(85.0)
  root.add(root_child0)
  let root_child0_child0 = @flex.Node::new()
  root_child0.add(root_child0_child0)
  let root_child0_child0_child0 = @flex.Node::new()
  root_child0_child0_child0.style.height = Pt(40.0)
  root_child0_child0_child0.style.width = Pt(40.0)
  root_child0_child0.add(root_child0_child0_child0)
  let root_child0_child1 = @flex.Node::new()
  root_child0_child1.style.margin.right = Pt(10.0)
  root_child0.add(root_child0_child1)
  let root_child0_child1_child0 = @flex.Node::new()
  root_child0_child1_child0.style.height = Pt(40.0)
  root_child0_child1_child0.style.width = Pt(40.0)
  root_child0_child1.add(root_child0_child1_child0)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 500.0, 500.0)
  check("root_child0", root_child0, 0.0, 0.0, 85.0, 80.0)
  check("root_child0_child0", root_child0_child0, 0.0, 0.0, 40.0, 40.0)
  check("root_child0_child0_child0", root_child0_child0_child0, 0.0, 0.0, 40.0, 40.0)
  check("root_child0_child1", root_child0_child1, 0.0, 40.0, 40.0, 40.0)
  check("root_child0_child1_child0", root_child0_child1_child0, 0.0, 0.0, 40.0, 40.0)
}

///|
test "wrap_nodes_with_content_sizing_margin_cross" {
  let root = @flex.Node::new()
