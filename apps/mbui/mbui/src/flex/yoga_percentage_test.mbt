  root.add(root_child0)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 60.0, 50.0)
  check("root_child0", root_child0, 0.0, 0.0, 30.0, 20.0)
}

///|
test "percent_of_max_cross_unstretched" {
  let root = @flex.Node::new()
  root.style.position = Absolute
  root.style.max_width = Pt(60.0)
  root.style.height = Pt(50.0)
  root.style.align_items = FlexStart
  let root_child0 = @flex.Node::new()
  root_child0.style.width = Pct(50.0)
  root_child0.style.height = Pt(20.0)
  root.add(root_child0)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 0.0, 50.0)
  check("root_child0", root_child0, 0.0, 0.0, 0.0, 20.0)
}
