diff --git a/src/c/ogv-decoder-video-av1.c b/src/c/ogv-decoder-video-av1.c
index 3ed92e0..b92b35c 100644
--- a/src/c/ogv-decoder-video-av1.c
+++ b/src/c/ogv-decoder-video-av1.c
@@ -6,0 +7,2 @@
+#include <stdint.h>
+#include <stddef.h>
@@ -143,8 +145,50 @@ static int process_frame_return(void *user_data)
-    ogvjs_callback_frame(frame->picture.data[0], frame->picture.stride[0],
-                         frame->picture.data[1], frame->picture.stride[1],
-                         frame->picture.data[2], frame->picture.stride[1],
-                         width, height,
-                         chromaWidth, chromaHeight,
-                         frame->picture.p.w, frame->picture.p.h,
-                         0, 0,
-                         frame->picture.p.w, frame->picture.p.h);
+    // ogv.js draws 8-bit planes. dav1d stores 10/12-bit samples in uint16_t planes; reduce those to 8 bits
+    // before giving them to the existing renderer. Keep the padded dimensions even, just as for 8-bit frames.
+    if (frame->picture.p.bpc > 8) {
+        if (width <= 0 || height <= 0 || chromaWidth <= 0 || chromaHeight <= 0 ||
+            (size_t)width > SIZE_MAX / (size_t)height ||
+            (size_t)chromaWidth > SIZE_MAX / (size_t)chromaHeight) {
+            dav1d_picture_unref(&frame->picture);
+            free(frame);
+            return 0;
+        }
+        size_t ysize = (size_t)width * (size_t)height;
+        size_t csize = (size_t)chromaWidth * (size_t)chromaHeight;
+        if (csize > (SIZE_MAX - ysize) / 2) {
+            dav1d_picture_unref(&frame->picture);
+            free(frame);
+            return 0;
+        }
+        uint8_t *planes = calloc(ysize + 2 * csize, 1);
+        if (!planes) {
+            dav1d_picture_unref(&frame->picture);
+            free(frame);
+            return 0;
+        }
+        const int shift = frame->picture.p.bpc - 8;
+        for (int plane = 0; plane < 3; plane++) {
+            int pw = plane ? (frame->picture.p.w + 1) / 2 : frame->picture.p.w;
+            int ph = plane ? (frame->picture.p.h + 1) / 2 : frame->picture.p.h;
+            int outStride = plane ? chromaWidth : width;
+            ptrdiff_t inStride = frame->picture.stride[plane ? 1 : 0];
+            uint8_t *out = planes + (plane == 0 ? 0 : ysize + (plane - 1) * csize);
+            for (int y = 0; y < ph; y++) {
+                const uint16_t *in = (const uint16_t *)((const uint8_t *)frame->picture.data[plane] + y * inStride);
+                for (int x = 0; x < pw; x++) out[(size_t)y * outStride + x] = (uint8_t)(in[x] >> shift);
+            }
+        }
+        ogvjs_callback_frame(planes, width, planes + ysize, chromaWidth, planes + ysize + csize, chromaWidth,
+                             width, height, chromaWidth, chromaHeight,
+                             frame->picture.p.w, frame->picture.p.h, 0, 0,
+                             frame->picture.p.w, frame->picture.p.h);
+        free(planes);
+    } else {
+        ogvjs_callback_frame(frame->picture.data[0], frame->picture.stride[0],
+                             frame->picture.data[1], frame->picture.stride[1],
+                             frame->picture.data[2], frame->picture.stride[1],
+                             width, height,
+                             chromaWidth, chromaHeight,
+                             frame->picture.p.w, frame->picture.p.h,
+                             0, 0,
+                             frame->picture.p.w, frame->picture.p.h);
+    }
