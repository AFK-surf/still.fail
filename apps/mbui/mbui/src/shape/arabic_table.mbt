///|
fn arabic_joining_b4(base : Int, i : Int) -> Int {
  (arabic_joining_u8[base + (i >> 1)] >> ((i & 1) << 2)) & 15
}

///|
/// The joining type: 0 U, 1 L, 2 R, 3 D, 4 alaph, 5 dalath-rish, 6 T, 7 by general category.
fn arabic_joining_type_raw(u : Int) -> Int {
  if u < 125260 && u >= 0 {
    let a = arabic_joining_b4(0, u >> 9)
    let b = arabic_joining_u8[123 + (a << 3) + ((u >> 6) & 7)]
    let c = arabic_joining_u8[209 + b + ((u >> 3) & 7)]
    arabic_joining_b4(441, (c << 3) + (u & 7))
  } else {
    7
  }
}
