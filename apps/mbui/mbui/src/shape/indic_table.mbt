fn indic_b4(i : Int) -> Int {
  (indic_u8[i >> 1] >> ((i & 1) << 2)) & 15
}

///|
/// A character's Indic category and position.
fn indic_categories(u : Int) -> (Int, Int) {
  let i = if u < 71396 && u >= 0 {
    indic_u8[996 + indic_u8[488 + (indic_u8[186 + (indic_u8[70 + (indic_b4(u >> 9) << 3) + ((u >> 6) & 7)] << 3) + ((u >> 3) & 7)] << 2) + ((u >> 1) & 3)] + (u & 1)]
  } else {
    37
  }
  let v = indic_values[i]
  (v & 0xFF, v >> 8)
}

