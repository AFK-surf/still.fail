///|
/// unicode-vo's char_orientation is Upright.
fn is_upright(c : Int) -> Bool {
  let mut i = 0
  while i < vo_ranges.length() {
    if c >= vo_ranges[i] && c <= vo_ranges[i + 1] {
      return vo_ranges[i + 2] == 1
    }
    i += 3
  }
  false
}
