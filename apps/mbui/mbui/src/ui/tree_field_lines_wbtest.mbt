///|
test "a field receives text and tells its input method where it is on its transparent entrance frame" {
  let t = Tester::new(fn(_) { }, w=300.0, h=240.0)
  let f = Field::new(text="写在这里")
  let alpha = @signals.signal(0.0)
  set_view_app(fn(root) {
    field(root, f, font_size=12.0, line=20.0, max_lines=2)
    .width(Is(Some(180.0))).offset(Is((25.0, 30.0)))
    .alpha(By(fn() { alpha.get() })) |> ignore
  })
  t.draw()
  f.focus()
  t.draw()
  assert_true(t.ime().0)
  assert_eq(t.ime().1, "写在这里")
  let (_, y, w, h) = t.ime_rect()
  assert_eq((y, w, h), (30.0, 2.0, 20.0))
  t.type_text("继续")
  assert_eq(f.text(), "写在这里继续")
  alpha.set(1.0)
  t.draw()
  assert_true(t.text_runs().iter().any(fn(r) { r.text == "写在这里继续" }))
}

///|
test "a retained field's sending snapshot follows its drawn offset and scale and survives clearing it" {
  let t = Tester::new(fn(_) {  }, w=300.0, h=240.0)
  let f = Field::new(text="first line\nsecond line")
  let scale = @signals.signal(1.0)
  let node : Ref[@view.View?] = Ref(None)
  set_view_app(fn(root) {
    node.val = Some(field(root, f, font_size=12.0, line=20.0, max_lines=4)
      .width(Is(Some(180.0))).offset(Is((25.0, 30.0)))
      .scale(By(fn() { scale.get() }), about=At(0.0, 0.0)))
  })
  t.draw()
  let plain = f.lines().unwrap()
  assert_eq(plain.text, "first line\nsecond line")
  assert_eq(plain.starts, [0, 11])
  assert_eq(plain.place(11).1 - plain.place(0).1, plain.line_h())
  scale.set(1.5)
  t.draw()
  let big = f.lines().unwrap()
  assert_eq(big.room.0, plain.room.0)
  assert_eq(big.room.1, plain.room.1)
  assert_eq(big.room.2, plain.room.2 * 1.5)
  assert_eq(big.line_h(), plain.line_h() * 1.5)
  assert_eq(big.place(11).1 - big.place(0).1, big.line_h())
  let start = big.place(0)
  let next = big.place(11)
  f.set("")
  t.draw()
  assert_eq((big.text, big.place(0), big.place(11)), ("first line\nsecond line", start, next))
  assert_eq(f.lines().unwrap().text, "")
}
