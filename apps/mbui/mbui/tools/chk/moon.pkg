import {
  "moonbitlang/core/cmp",
  "mbctools/re",
  "mbctools/rjson",
  "mbctools/sys",
  "mbctools/png",
  "moonbitlang/core/math",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
}

options(
  "is-main": true,
