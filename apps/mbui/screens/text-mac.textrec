{"s":[21.599999999999998,600,0,"第一章 雨后的车站"],"r":[0,1,20.584962406015034,75,1,1,20.584962406015034,76,2,1,20.58496240601503,77,3,1,4.790725007175936,-1,4,1,20.584962406015038,78,5,1,20.584962406015038,79,6,1,20.584962406015038,80,7,1,20.584962406015023,81,8,1,20.584962406015023,82]}
