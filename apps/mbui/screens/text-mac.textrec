{"s":[21.599999999999998,600,0,"第一章 雨后的车站"],"r":[0,1,20.584962406015034,117,1,1,20.584962406015034,118,2,1,20.58496240601503,119,3,1,4.790725007175936,-1,4,1,20.584962406015038,120,5,1,20.584962406015038,121,6,1,20.584962406015038,122,7,1,20.584962406015023,123,8,1,20.584962406015023,124]}
