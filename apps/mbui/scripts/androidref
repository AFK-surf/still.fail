#!/bin/bash
# The mbui app's pictures held to Android's (tools/androidref, in MoonBit: its main.mbt says how), for
# scripts/android-ref.sh:  scripts/androidref REFS MBUI OUT ALLOWED NAME…
# Built here only when there is none built from these very sources (by content).
D=$(cd "$(dirname "$0")" && pwd)
A=$(cd "$D/.." && pwd)
# (moon: the toolchain the scripts use)
. "$D/env.sh"
T=$A/tools
B=$T/_build/native/release/build/sftools/androidref/androidref.exe
src=$(cd "$A" && find tools/androidref tools/moon.mod tools/moon.work mbui/tools/sys mbui/tools/png -type f | LC_ALL=C sort | xargs cat | cksum)
if [ ! -x "$B" ] || [ "$(cat "$B.src" 2>/dev/null)" != "$src" ]; then
  (cd "$T" && env -u MOON_CC moon build --target native --release >&2) || { echo "androidref: tools/androidref did not build" >&2; exit 1; }
  echo "$src" > "$B.src"
fi
exec "$B" "$@"
