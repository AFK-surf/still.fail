#!/bin/bash
# The files the app carries in its code written out for the browser's build (tools/assets, in MoonBit: its main.mbt
# says what):  scripts/assets <app module> <out dir>
# Built here only when there is none built from these very sources (by content).
D=$(cd "$(dirname "$0")" && pwd)
A=$(cd "$D/.." && pwd)
# (moon: the toolchain the scripts use)
. "$D/env.sh"
T=$A/tools
TOOLS_SCRIPTS=$A/../../libs/mbui/scripts; . "$TOOLS_SCRIPTS/tooltarget.sh"
B=$T/_build/$TT/release/build/sftools/assets/assets.$TX
src=$(cd "$A" && find tools/assets tools/moon.mod tools/moon.work ../../libs/mbui/tools/sys -type f | LC_ALL=C sort | xargs cat | cksum)
if [ ! -f "$B" ] || [ "$(cat "$B.src" 2>/dev/null)" != "$src" ]; then
  (cd "$T" && env -u MOON_CC moon build --target $TT --release assets >&2) || { echo "assets: tools/assets did not build" >&2; exit 1; }
  echo "$src" > "$B.src"
fi
tool_exec "$B" "$@"
