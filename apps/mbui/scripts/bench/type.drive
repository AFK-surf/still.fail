# 小屏, a finger: a long chat's composer pressed, then typed into, a key each 100 ms (as scripts/latency.sh's type
# does on a device): what a key typed costs, the chat's rows above it unchanged.
timeout 20000
until 发消息
wait 500
tap 发消息
wait 800
log measure
type h
wait 100
type e
wait 100
type l
wait 100
type l
wait 100
type o
wait 100
type w
wait 100
type o
wait 100
type r
wait 100
type l
wait 100
type d
wait 100
type t
wait 100
type y
wait 100
type p
wait 100
type i
wait 100
type n
wait 100
type g
wait 100
type a
wait 100
type k
wait 100
type e
wait 100
type y
wait 100
wait 300
exit
