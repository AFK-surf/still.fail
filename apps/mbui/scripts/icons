#!/bin/bash
# still.fail's own icons for the web (tools/icons, in MoonBit: its main.mbt says what), into web/ui/src/icons.tsx from
# design/icons and design/station-icons:  scripts/icons <repository> [--check]
# Built here only when there is none built from these very sources (by content).
D=$(cd "$(dirname "$0")" && pwd)
A=$(cd "$D/.." && pwd)
# (moon: the toolchain the scripts use)
. "$D/env.sh"
T=$A/tools
B=$T/_build/native/release/build/sftools/icons/icons.exe
src=$(cd "$A" && find tools/icons tools/moon.mod tools/moon.work mbui/tools/sys -type f | LC_ALL=C sort | xargs cat | cksum)
if [ ! -x "$B" ] || [ "$(cat "$B.src" 2>/dev/null)" != "$src" ]; then
  (cd "$T" && env -u MOON_CC moon build --target native --release >&2) || { echo "icons: tools/icons did not build" >&2; exit 1; }
  echo "$src" > "$B.src"
fi
exec "$B" "$@"
