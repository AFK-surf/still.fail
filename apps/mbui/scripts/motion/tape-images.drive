# Laid out Medium on an opened fold's inner screen (MBUI_WIN=690x840 MBUI_FILM_PLATFORM=2), the made-up chat brought
# over and scrolled up to its pictures: each in its message as on the wide frame (messages' image_reveal).
system {"size_class":{"width":"medium","height":"medium"}}
timeout 20000
until 发消息
wait 600
tapxy -80 420
wait 900
wheel -900
wait 1800
exit
