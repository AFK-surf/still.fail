#!/bin/bash
# The app's words in Chinese and English from client/i18n/catalog (tools/strings, in MoonBit: its main.mbt says what),
# for the keys each package says (words.txt), into src/sfbase/strings_{zh,en}.mbt and
# src/sfapp/settings/strings_{zh,en}.mbt:  scripts/strings <repository>
# Built here only when there is none built from these very sources (by content).
D=$(cd "$(dirname "$0")" && pwd)
A=$(cd "$D/.." && pwd)
# (moon: the toolchain the scripts use)
. "$D/env.sh"
T=$A/tools
B=$T/_build/native/release/build/sftools/strings/strings.exe
src=$(cd "$A" && find tools/strings tools/moon.mod tools/moon.work mbui/tools/sys -type f | LC_ALL=C sort | xargs cat | cksum)
if [ ! -x "$B" ] || [ "$(cat "$B.src" 2>/dev/null)" != "$src" ]; then
  (cd "$T" && env -u MOON_CC moon build --target native --release >&2) || { echo "strings: tools/strings did not build" >&2; exit 1; }
  echo "$src" > "$B.src"
fi
exec "$B" "$@"
