    #|{"name":"threads: random 36","old":[{"id":"r0","title":"chat r0","last":{"seq":0,"text":"t0","at":1790000000000},"unread":1,"people":["a","b"]},{"id":"r1","title":"chat r1","last":{"seq":1,"text":"t1","at":1790000001000.5},"unread":0,"people":["a","b"]},{"id":"r2","title":"chat r2","last":{"seq":2,"text":"t2","at":1790000002001},"unread":0,"people":["a","b"]},{"id":"r3","title":"chat r3","last":{"seq":3,"text":"t3","at":1790000003001.5},"unread":0,"people":["a","b"]},{"id":"r4","title":"chat r4","last":{"seq":4,"text":"t4","at":1790000004002},"unread":0,"people":["a","b"]},{"id":"r5","title":"chat r5","last":{"seq":5,"text":"t5","at":1790000005002.5},"unread":2,"people":["a","b"]},{"id":"r6","title":"chat r6","last":{"seq":6,"text":"t6","at":1790000006003},"unread":0,"people":["a","b"]},{"id":"r7","title":"chat r7","last":{"seq":7,"text":"t7","at":1790000007003.5},"unread":1,"people":["a","b"]},{"id":"r8","title":"chat r8","last":{"seq":8,"text":"t8","at":1790000008004},"unread":0,"people":["a","b"]}],"ops":[{"path":[],"key":["id"],"drop":"r4"}],"want":[{"id":"r0","title":"chat r0","last":{"seq":0,"text":"t0","at":1790000000000},"unread":1,"people":["a","b"]},{"id":"r1","title":"chat r1","last":{"seq":1,"text":"t1","at":1790000001000.5},"unread":0,"people":["a","b"]},{"id":"r2","title":"chat r2","last":{"seq":2,"text":"t2","at":1790000002001},"unread":0,"people":["a","b"]},{"id":"r3","title":"chat r3","last":{"seq":3,"text":"t3","at":1790000003001.5},"unread":0,"people":["a","b"]},{"id":"r5","title":"chat r5","last":{"seq":5,"text":"t5","at":1790000005002.5},"unread":2,"people":["a","b"]},{"id":"r6","title":"chat r6","last":{"seq":6,"text":"t6","at":1790000006003},"unread":0,"people":["a","b"]},{"id":"r7","title":"chat r7","last":{"seq":7,"text":"t7","at":1790000007003.5},"unread":1,"people":["a","b"]},{"id":"r8","title":"chat r8","last":{"seq":8,"text":"t8","at":1790000008004},"unread":0,"people":["a","b"]}]}
  check_vector(v)
}

///|
test "core-ts: threads: random 37" {
  let v =
    #|{"name":"threads: random 37","old":[{"id":"r0","title":"chat r0","last":{"seq":0,"text":"t0","at":1790000000000},"unread":1,"people":["a","b"]},{"id":"r1","title":"chat r1","last":{"seq":1,"text":"t1","at":1790000001000.5},"unread":0,"people":["a","b"]},{"id":"r2","title":"chat r2","last":{"seq":2,"text":"t2","at":1790000002001},"unread":2,"people":["a","b"]},{"id":"r3","title":"chat r3","last":{"seq":3,"text":"t3","at":1790000003001.5},"unread":0,"people":["a","b"]},{"id":"r4","title":"chat r4","last":{"seq":4,"text":"t4","at":1790000004002},"unread":0,"people":["a","b"]}],"ops":[{"path":[],"key":["id"],"drop":"r2"}],"want":[{"id":"r0","title":"chat r0","last":{"seq":0,"text":"t0","at":1790000000000},"unread":1,"people":["a","b"]},{"id":"r1","title":"chat r1","last":{"seq":1,"text":"t1","at":1790000001000.5},"unread":0,"people":["a","b"]},{"id":"r3","title":"chat r3","last":{"seq":3,"text":"t3","at":1790000003001.5},"unread":0,"people":["a","b"]},{"id":"r4","title":"chat r4","last":{"seq":4,"text":"t4","at":1790000004002},"unread":0,"people":["a","b"]}]}
  check_vector(v)
}

///|
test "core-ts: threads: random 38" {
  let v =
    #|{"name":"threads: random 38","old":[{"id":"r0","title":"chat r0","last":{"seq":0,"text":"t0","at":1790000000000},"unread":0,"people":["a","b"]}],"ops":[{"path":[],"key":["id"],"drop":"r0"}],"want":[]}
  check_vector(v)
}

///|
test "core-ts: threads: random 39" {
  let v =
    #|{"name":"threads: random 39","old":[{"id":"r0","title":"chat r0","last":{"seq":0,"text":"t0","at":1790000000000},"unread":1,"people":["a","b"]}],"ops":[{"path":[],"key":["id"],"drop":"r0"}],"want":[]}
  check_vector(v)
}

///|
test "core-ts: set: through a key not there" {
  let v =
    #|{"name":"set: through a key not there","old":{"a":{"b":[1,2,3]},"s":"x"},"ops":[{"path":["nope","deeper"],"set":1}],"want":{"a":{"b":[1,2,3]},"s":"x"}}
  check_vector(v)
}

///|
test "core-ts: set: a key not there, last on the path" {
  let v =
    #|{"name":"set: a key not there, last on the path","old":{"a":{"b":[1,2,3]},"s":"x"},"ops":[{"path":["a","c"],"set":{"new":true}}],"want":{"a":{"b":[1,2,3],"c":{"new":true}},"s":"x"}}
  check_vector(v)
}

///|
test "core-ts: set: an index past the end" {
  let v =
    #|{"name":"set: an index past the end","old":{"a":{"b":[1,2,3]},"s":"x"},"ops":[{"path":["a","b",3],"set":9}],"want":{"a":{"b":[1,2,3]},"s":"x"}}
  check_vector(v)
}

///|
test "core-ts: set: an index into an object" {
  let v =
    #|{"name":"set: an index into an object","old":{"a":{"b":[1,2,3]},"s":"x"},"ops":[{"path":["a",0],"set":9}],"want":{"a":{"b":[1,2,3]},"s":"x"}}
  check_vector(v)
}

///|
test "core-ts: set: a key into an array" {
  let v =
    #|{"name":"set: a key into an array","old":{"a":{"b":[1,2,3]},"s":"x"},"ops":[{"path":["a","b","x"],"set":9}],"want":{"a":{"b":[1,2,3]},"s":"x"}}
  check_vector(v)
}

///|
test "core-ts: set: the whole value" {
  let v =
    #|{"name":"set: the whole value","old":{"a":{"b":[1,2,3]},"s":"x"},"ops":[{"path":[],"set":null}],"want":null}
  check_vector(v)
}

///|
test "core-ts: set: null at a key" {
  let v =
    #|{"name":"set: null at a key","old":{"a":{"b":[1,2,3]},"s":"x"},"ops":[{"path":["s"],"set":null}],"want":{"a":{"b":[1,2,3]},"s":null}}
  check_vector(v)
}

///|
test "core-ts: append: to what is not an array" {
  let v =
    #|{"name":"append: to what is not an array","old":{"a":{"b":[1,2,3]},"s":"x"},"ops":[{"path":["s"],"append":[1]}],"want":{"a":{"b":[1,2,3]},"s":"x"}}
  check_vector(v)
}

///|
test "core-ts: append: then set in it" {
  let v =
    #|{"name":"append: then set in it","old":{"a":{"b":[1,2,3]},"s":"x"},"ops":[{"path":["a","b"],"append":[4,5]},{"path":["a","b",4],"set":"five"}],"want":{"a":{"b":[1,2,3,4,"five"]},"s":"x"}}
  check_vector(v)
}

///|
test "core-ts: remove: a key" {
  let v =
    #|{"name":"remove: a key","old":{"a":{"b":[1,2,3]},"s":"x"},"ops":[{"path":["a"],"remove":true}],"want":{"s":"x"}}
  check_vector(v)
}

///|
test "core-ts: remove: a key not there" {
  let v =
    #|{"name":"remove: a key not there","old":{"a":{"b":[1,2,3]},"s":"x"},"ops":[{"path":["zz"],"remove":true}],"want":{"a":{"b":[1,2,3]},"s":"x"}}
  check_vector(v)
}

///|
test "core-ts: remove: at the root" {
  let v =
    #|{"name":"remove: at the root","old":{"a":{"b":[1,2,3]},"s":"x"},"ops":[{"path":[],"remove":true}],"want":{"a":{"b":[1,2,3]},"s":"x"}}
  check_vector(v)
}

///|
test "core-ts: remove: an index" {
  let v =
    #|{"name":"remove: an index","old":{"a":{"b":[1,2,3]},"s":"x"},"ops":[{"path":["a","b",0],"remove":true}],"want":{"a":{"b":[1,2,3]},"s":"x"}}
  check_vector(v)
}

///|
test "core-ts: keyed: on what is not a list" {
  let v =
    #|{"name":"keyed: on what is not a list","old":{"items":[{"id":"a","v":1},{"id":"b","v":2},{"id":"c","v":3}]},"ops":[{"path":[],"key":["id"],"drop":"a"}],"want":{"items":[{"id":"a","v":1},{"id":"b","v":2},{"id":"c","v":3}]}}
  check_vector(v)
}

///|
test "core-ts: keyed: drop one not there" {
  let v =
    #|{"name":"keyed: drop one not there","old":{"items":[{"id":"a","v":1},{"id":"b","v":2},{"id":"c","v":3}]},"ops":[{"path":["items"],"key":["id"],"drop":"zz"}],"want":{"items":[{"id":"a","v":1},{"id":"b","v":2},{"id":"c","v":3}]}}
  check_vector(v)
}

///|
test "core-ts: keyed: patch one not there" {
  let v =
    #|{"name":"keyed: patch one not there","old":{"items":[{"id":"a","v":1},{"id":"b","v":2},{"id":"c","v":3}]},"ops":[{"path":["items"],"key":["id"],"patch":"zz","ops":[{"path":["v"],"set":0}]}],"want":{"items":[{"id":"a","v":1},{"id":"b","v":2},{"id":"c","v":3}]}}
  check_vector(v)
}

///|
test "core-ts: keyed: move one not there" {
  let v =
    #|{"name":"keyed: move one not there","old":{"items":[{"id":"a","v":1},{"id":"b","v":2},{"id":"c","v":3}]},"ops":[{"path":["items"],"key":["id"],"move":"zz","before":"a"}],"want":{"items":[{"id":"a","v":1},{"id":"b","v":2},{"id":"c","v":3}]}}
  check_vector(v)
}

///|
test "core-ts: keyed: move before one not there" {
  let v =
    #|{"name":"keyed: move before one not there","old":{"items":[{"id":"a","v":1},{"id":"b","v":2},{"id":"c","v":3}]},"ops":[{"path":["items"],"key":["id"],"move":"a","before":"zz"}],"want":{"items":[{"id":"b","v":2},{"id":"c","v":3},{"id":"a","v":1}]}}
  check_vector(v)
}

///|
test "core-ts: keyed: move to the end" {
  let v =
    #|{"name":"keyed: move to the end","old":{"items":[{"id":"a","v":1},{"id":"b","v":2},{"id":"c","v":3}]},"ops":[{"path":["items"],"key":["id"],"move":"a","before":null}],"want":{"items":[{"id":"b","v":2},{"id":"c","v":3},{"id":"a","v":1}]}}
  check_vector(v)
}

///|
test "core-ts: keyed: put one there, in place" {
  let v =
    #|{"name":"keyed: put one there, in place","old":{"items":[{"id":"a","v":1},{"id":"b","v":2},{"id":"c","v":3}]},"ops":[{"path":["items"],"key":["id"],"put":{"id":"b","v":20}}],"want":{"items":[{"id":"a","v":1},{"id":"b","v":20},{"id":"c","v":3}]}}
  check_vector(v)
}

///|
test "core-ts: keyed: put one there, before another" {
  let v =
    #|{"name":"keyed: put one there, before another","old":{"items":[{"id":"a","v":1},{"id":"b","v":2},{"id":"c","v":3}]},"ops":[{"path":["items"],"key":["id"],"put":{"id":"c","v":30},"before":"a"}],"want":{"items":[{"id":"c","v":30},{"id":"a","v":1},{"id":"b","v":2}]}}
  check_vector(v)
}

///|
test "core-ts: keyed: put one there, at the end" {
  let v =
    #|{"name":"keyed: put one there, at the end","old":{"items":[{"id":"a","v":1},{"id":"b","v":2},{"id":"c","v":3}]},"ops":[{"path":["items"],"key":["id"],"put":{"id":"a","v":10},"before":null}],"want":{"items":[{"id":"b","v":2},{"id":"c","v":3},{"id":"a","v":10}]}}
  check_vector(v)
}

///|
test "core-ts: keyed: put a new one, no before" {
  let v =
    #|{"name":"keyed: put a new one, no before","old":{"items":[{"id":"a","v":1},{"id":"b","v":2},{"id":"c","v":3}]},"ops":[{"path":["items"],"key":["id"],"put":{"id":"d","v":4}}],"want":{"items":[{"id":"a","v":1},{"id":"b","v":2},{"id":"c","v":3},{"id":"d","v":4}]}}
  check_vector(v)
}

///|
test "core-ts: keyed: patch, nested keyed" {
  let v =
    #|{"name":"keyed: patch, nested keyed","old":{"rows":[{"id":"x","sub":[{"id":1},{"id":2}]}]},"ops":[{"path":["rows"],"key":["id"],"patch":"x","ops":[{"path":["sub"],"key":["id"],"drop":1}]}],"want":{"rows":[{"id":"x","sub":[{"id":2}]}]}}
  check_vector(v)
}

///|
test "core-ts: keyed: two fields, one missing" {
  let v =
    #|{"name":"keyed: two fields, one missing","old":{"rows":[{"s":"w/1","id":"a"},{"s":"w/1"}]},"ops":[{"path":["rows"],"key":["s","id"],"drop":["w/1",null]}],"want":{"rows":[{"s":"w/1","id":"a"}]}}
  check_vector(v)
}

///|
test "core-ts: keyed: an item not an object" {
  let v =
    #|{"name":"keyed: an item not an object","old":{"rows":[1,{"id":null}]},"ops":[{"path":["rows"],"key":["id"],"drop":null}],"want":{"rows":[{"id":null}]}}
  check_vector(v)
}
