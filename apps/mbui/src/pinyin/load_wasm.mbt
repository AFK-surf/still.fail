///|
fn mbw_stillfail_pinyin_read_file(path : Int) -> Int = "mbhost" "stillfail_pinyin_read_file"

///|
fn read_file(path : Bytes) -> Bytes {
  let mbw_m = @wasmrt.mark()
  let mbw_r = @wasmrt.take_bytes(mbw_stillfail_pinyin_read_file(@wasmrt.bytes_addr(path)))
  @wasmrt.settle(mbw_m)
  mbw_r
}

///|
fn mbw_stillfail_pinyin_write_file(path : Int, data : Int) -> Int = "mbhost" "stillfail_pinyin_write_file"

///|
fn write_file(path : Bytes, data : Bytes) -> Int {
  let mbw_m = @wasmrt.mark()
  let mbw_r = mbw_stillfail_pinyin_write_file(@wasmrt.bytes_addr(path), @wasmrt.bytes_addr(data))
  @wasmrt.settle(mbw_m)
  mbw_r
}

///|
/// The words in the file at `path` (words.txt, where the host put it), or None when it cannot be read.
pub fn Dict::load(path : String) -> Dict? {
  match read_text(path) {
    Some(t) => Some(Dict::parse(t))
    None => None
  }
}

///|
/// The text of the file at `path`, or None when it cannot be read (or is empty).
pub fn read_text(path : String) -> String? {
  let b = read_file(@utf8.encode(path + "\u{0}"))
  if b.length() == 0 {
    return None
  }
  Some(@utf8.decode_lossy(b))
}

///|
/// `text` kept in the file at `path` (whole or not at all); false when it could not be.
pub fn write_text(path : String, text : String) -> Bool {
  write_file(@utf8.encode(path + "\u{0}"), @utf8.encode(text)) == 1
}

