// Whether one presented is open, read where nodes are made and bound (a reaction of a page's that says what it opened
// closed as it closes for anything: chat_pops_node's).

///|
/// Whether the one presented as `serial` is open (presented_open_of's), followed: what reads it told again as what is
/// presented changes (presented_said).
pub fn presented_open_now(serial : Int) -> Bool {
  presented_said.get() |> ignore
  presented_open_of(serial)
}
