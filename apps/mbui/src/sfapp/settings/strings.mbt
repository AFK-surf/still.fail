///|
/// The words for `key`.
fn tr(key : String) -> String {
  zh.get(key).unwrap_or(key)
}

///|
/// The words for `key` with `{name}`s put in.
fn fill(key : String, args : Array[(String, String)]) -> String {
  let mut s = tr(key)
  for a in args {
    s = s.replace_all(old="{" + a.0 + "}", new=a.1)
  }
  s
}
