// What of this package's files reads the time as a node's property (mbui's src/view/clock_read.mbt: a bar a file, the
// places in it that may, each going and only falling).

///|
fn init {
  @view.clock_read_known([
    // the viewer's strip (its pins, picture and mark lines: strip_at), going to where they are drawn
    ("logic_at", "stillfail/src/sfbase/viewer_tree.mbt", 6),
    ("drawn_at", "stillfail/src/sfbase/viewer_tree.mbt", 6),
  ])
}
