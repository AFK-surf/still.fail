import {
  "mbui/halt",
  "moonbitlang/core/math",
  "moonbitlang/core/buffer",
  "moonbitlang/core/double",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "mbui/ui",
  "mbui/hostapi",
  "mbui/zip",
  "mbui/kit",
  "mbui/codec",
  "mbui/motion",
  "mbui/pixels",
  "mbui/dmath",
  "mbui/signals",
  "mbui/view",
  "stillfail/sf",
  "stillfail/gallery",
  "stillfail/sfapp/settings",
}

options(
  // (the files the app carries: in its code on the native hosts, fetched beside its script in a browser)
  targets: {
    "inter_face.mbt": [ "native", "wasm", "wasm-gc" ],
    "inter_face_js.mbt": [ "js" ],
    "inter_face_native.mbt": [ "native", "wasm", "wasm-gc" ],
    "mermaid_hbc.mbt": [ "native", "wasm", "wasm-gc" ],
    "mermaid_script_native.mbt": [ "native", "wasm", "wasm-gc" ],
    "mermaid_script_js.mbt": [ "js" ],
    "share_face.mbt": [ "native", "wasm", "wasm-gc" ],
    "share_face_native.mbt": [ "native", "wasm", "wasm-gc" ],
    "share_face_js.mbt": [ "js" ],
  },
)
