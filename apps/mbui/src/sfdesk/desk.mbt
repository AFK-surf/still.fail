// The desktop's own: its pages and what they hold, each ported from the web's file (or the desktop app's) and made of
// the library's parts (src/sf), reading what sfbase reads. Nothing of the phone's pages is here or reachable from here
// (sfapp imports this package, so this one cannot import it); what both need is the library's or sfbase's.

///|
/// What this package keeps put back as the app begins anew (its reset).
pub fn reset() -> Unit {
  @sfpages.reset()
  wide_reset()
  publish_reset()
  new_ws_reset()
  share_dialog_reset()
  relay_focus.val = ""
  marks_reset()
  context_reset()
  switcher_reset()
  browse_reset()
  cols_reset()
  kept_reset()
  pane_reset()
  drag_reset()
  transfers_reset()
  tab_reset()
  sv_reset()
  dialogs_reset()
  drive_reset()
  shell_reset()
  nav_reset()
  go_reset()
  row_menu_reset()
  attention_reset()
  newchat_reset()
  composing_reset()
  page_switch_reset()
  triple_reset()
  history_reset()
  find_close()
  jobs_reset()
  open_jobs_reset()
  letters_reset()
  side_slide_reset()
  settings_reset()
  station_page_reset()
  profile_page_reset()
  font_setting_reset()
  changelog_reset()
  vault_item_reset()
  memory_doc_reset()
  add_profile_reset()
  station_cards_reset()
  places_reset()
  chat_page_reset()
  usage_reset()
  steps_reset()
  layers_reset()
  zou_page_reset()
}
