import {
  "mbui/host",
  "mbui/hostapi",
  "mbui/ui",
  "stillfail/sf",
  "stillfail/sfkept",
  "stillfail/sfapp",
  "stillfail/sffixture",
  "stillfail/sfdesk",
  "mbui/wasmrt",
}

options(
  "is-main": true,
  // (what the native shell calls of the program, in a program built for Wasm alone: as the app's)
  targets: { "wasm_shell.mbt": [ "wasm" ] },
  link: {
    "js": { "format": "iife" },
    // (run by mbui's native shell as the app is: what it calls of the program, wasm_shell.mbt)
    "wasm": { "exports": ["mbw_string", "mbw_bytes"], "export-memory-name": "memory" },
    "native": {
      "cc-link-flags": "-framework Cocoa -framework Metal -framework QuartzCore -framework CoreText -framework CoreGraphics -framework ImageIO -framework AVFoundation -framework CoreMedia -framework CoreVideo -framework WebKit",
    },
  },
)
