  #|["code.ink","mbt\u0001///|\n/// Rows put in before the anchor move it with them.\nfn ListState::moved(self : ListState, at : Int, n : Int) -> Unit {\n  if self.anchor >= at {\n    self.anchor = self.anchor + n\n  }\n}","b58g3i9c2i5ck5c2l9c2a3c2l3c2a2c2l3c5l5c4g3k4ca7h3a3c6k4ca7c2k4ca7h2a4c3"]
  #|["code.ink","mbt\u0001///|\n/// Rows put in before the anchor move it with them.\nfn ListState::moved(self : ListState, at : Int, n : Int) -> Unit {\n  if self.anchor >= at {\n    self.anchor = self.anchor + n\n  }\n}\n","b58g3i9c2i5ck5c2l9c2a3c2l3c2a2c2l3c5l5c4g3k4ca7h3a3c6k4ca7c2k4ca7h2a4c4"]
