}

pub(all) struct ComposerSpec {
  station : String
  draft : String
  session : String
  placeholder : String
  toolbar : (() -> Unit)?
  note : Array[(String, String)]
  tail : (() -> Unit)?
  roomy : Bool
  locked : Bool
  offline : Bool
}

pub(all) struct ContextEntry {
  open : () -> Unit
  busy : Bool
  compacts : Bool
}

pub(all) struct FindList {
  showing : () -> (Double, Double)
  go : (Double, Array[String]) -> Unit
  forget : () -> Unit
}

pub(all) struct Finding {
  mut chat : String
  field : @ui.Field
  mut query : String
  asked : @signals.Signal[String]
  found : @signals.Signal[Found?]
  at : @signals.Signal[Int32]
  k : @signals.Signal[Int32]
  position : @signals.Signal[Int32]
  total : @signals.Signal[Int32]
  mut moves : Int32
  bringing : @signals.Signal[Bool]
}

pub(all) struct Found {
  words : Array[String]
  hits : Array[(Double, Int32)]
  held : Int32
  of : Int32
  whole : Bool
}

pub(all) struct ListMotion {
  rk : String
  turns : @sfbase.Turns
  emits : @sfbase.Emits
  flight : @sfbase.SendFlight?
}

pub(all) struct ListPart {
  key : String
  draw : () -> Unit
  tucked : Bool
}

pub(all) struct ListsFrame {
  top : Double
  under : Double
  foot : Double
  inset : Double
  ground : Int64
  before : (String, @sfbase.ChatsView?) -> Array[ListPart]
  after : (String, @sfbase.ChatsView?) -> Array[ListPart]
  others : Array[() -> Unit]
  shown : Int32
  at : @sf.ListAt
}

pub(all) struct MessageHere {
  station : String
  session : String
  view : @sfbase.ChatView
  go : ((Double, String) -> Unit)?
  inline : Bool
  gutter : Double
  list : ListMotion?
  core : @settings.Core?
}

pub(all) struct NewChatFrame {
  core : @settings.Core
  bar : () -> Unit
  foot : Double
  in_place : Bool
  sent : (@sfbase.ChatRef) -> Unit
}

pub(all) struct Offered {
  id : String
  label : String
  group : String
  words : String
  typed : Bool
  version : String
  station : String
  icon : String
  keys : String
  run : () -> Unit
}

pub(all) enum SettingsLead {
  Icon(String)
  Person
  Space(String, String)
}

pub(all) struct SettingsPart {
  heading : String
  rows : Array[SettingsRow]
}

pub(all) struct SettingsRow {
  route : @settings.Route
  key : String
  lead : SettingsLead
  title : String
  line : String
  value : String
  bad : Bool
  dot : Bool
}

pub(all) struct SquareParts {
  square : (Int64, () -> Unit, Int32) -> Int32
  corner : (String) -> Unit
