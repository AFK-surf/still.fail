pub(all) struct ComposerPlace {
  capsule_in : (Double, Double, Double)
  capsule_pad : Double
  corner : Double
}

pub(all) struct ComposerSpec {
  station : String
  draft : String
  session : String
  placeholder : String
  toolbar : (() -> Unit)?
  note : Array[(String, String)]
  tail : (() -> Unit)?
  roomy : Bool
  locked : Bool
  offline : Bool
  warm_agent : Bool
}

pub(all) struct ContextEntry {
  open : () -> Unit
  busy : Bool
  compacts : Bool
}

pub(all) struct FindList {
  showing : () -> (Double, Double)
  go : (Double, Array[String]) -> Unit
  forget : () -> Unit
}

pub(all) struct Finding {
  chat : @signals.Signal[String]
  field : @ui.Field
  mut query : String
  asked : @signals.Signal[String]
  found : @signals.Signal[Found?]
  at : @signals.Signal[Int32]
  k : @signals.Signal[Int32]
  position : @signals.Signal[Int32]
  total : @signals.Signal[Int32]
  mut moves : Int32
  bringing : @signals.Signal[Bool]
}

pub(all) struct Found {
  words : Array[String]
  hits : Array[(Double, Int32)]
  held : Int32
  of : Int32
  whole : Bool
}

pub(all) struct ListMotion {
  rk : String
  turns : @sfbase.Turns
  emits : @sfbase.Emits
  flight : @sfbase.SendFlight?
}

pub(all) struct ListPart {
  key : String
  draw : () -> Unit
  tucked : Bool
}

pub(all) struct ListsNodeFrame {
  top : () -> Double
  under : () -> Double
  foot : () -> Double
  ground : () -> Int64
  before : (String, @sfbase.ChatsView?) -> Array[NodePart]
  after : (String, @sfbase.ChatsView?) -> Array[NodePart]
  others : Array[(@view.View) -> Unit]
  shown : () -> Int32
  at : @sf.ListAt
  watched : () -> Bool
}

type MapPlace

pub(all) struct MessageHere {
  station : String
  session : String
  view : @sfbase.ChatView
  go : ((Double, String) -> Unit)?
  inline : Bool
  gutter : Double
  list : ListMotion?
  core : @settings.Core?
}

pub(all) struct NewChatFrame {
