// The files the end-to-end runs share, send and upload (e2e/run.sh: e2e-photo.jpg, the first JPEG of mbui's
// test/images; e2e-doc.pdf, made by mbui's test/apple_views/make_pdf.py; e2e-data.bin, by a rule), byte for byte: what
// an upload's id is made from (its bytes' hash: sfapp's upload_id), so a replay sends what the run did (the flows'
// tests: Tester::share_in, Tester::picks).

///|
fn e2e_bytes(hex : String) -> Bytes {
  let digit = fn(c : Char) -> Int {
    let n = c.to_int()
    if n >= '0'.to_int() && n <= '9'.to_int() { n - '0'.to_int() } else { n - 'a'.to_int() + 10 }
  }
  let cs = hex.to_array().filter(fn(c) { c != '\n' })
  Bytes::makei(cs.length() / 2, fn(i) { ((digit(cs[2 * i]) << 4) | digit(cs[2 * i + 1])).to_byte() })
}

