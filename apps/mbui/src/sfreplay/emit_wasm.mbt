// Generated by mbui's scripts/wasmhost from emit_native.mbt: the file on classic Wasm, its C calls the native shell's
// imports (mbui/tools/wasmhost/main.mbt says how). Not to be edited: change emit_native.mbt and run scripts/wasmhost.
///|
fn mbw_sfr_emit_path() -> Int = "mbhost" "sfr_emit_path"

///|
fn emit_path_bytes() -> Bytes {
  @wasmrt.take_bytes(mbw_sfr_emit_path())
}

///|
fn mbw_sfr_write_file(path : Int, text : Int) -> Int = "mbhost" "sfr_write_file"

///|
fn write_bytes(path : Bytes, text : Bytes) -> Int {
  mbw_sfr_write_file(@wasmrt.bytes_addr(path), @wasmrt.bytes_addr(text))
}

///|
/// Where a flow's steps go as a scripted run's (FLOW_EMIT, scripts/rerecord.sh): "" when nothing asks for them.
fn emit_path() -> String {
  @utf8.decode_lossy(emit_path_bytes()[:])
}

///|
fn write_file(path : String, text : String) -> Unit {
  write_bytes(@utf8.encode(path), @utf8.encode(text)) |> ignore
}

