// 83-profile (e2e/traces/settings-profile.trace): the profile → "…" → 重命名 (profile.put), 重新检查 (profile.check), named
// cc again; ＋: the providers, Anthropic → API key, a made-up key, 验证并添加: refused, nothing added.

///|
test "83-profile" {
  @sfreplay.orders(fn(seed) raise {
    let f = @sfreplay.Flow::start(@sfreplay.trace_settings_profile, seed~)
    f.tap("icon:settings")
    f.run_to(@ui.nav_rest())
    f.tap("=Profile")
    f.run_to(@ui.nav_rest())
    f.tap("=cc")
    f.run_to(@ui.nav_rest())
    f.see("使用它的连接")
    f.tap("icon:more")
    f.run_to(@kit.sheet_rest("settings-sheet"))
    f.tap("=重命名")
    f.run_to(@kit.sheet_rest("settings-sheet"))
    f.see("Profile 名称")
    f.clear()
    f.type_text("e2e-080726")
    f.tap("=保存")
    // said as the station answers, the sheet still going down (its toast's time its own: looked at as it shows)
    f.see("已重命名")
    f.run_to(@kit.sheet_rest("settings-sheet"))
    f.see("=e2e-080726")
    f.tap("icon:more")
    f.run_to(@kit.sheet_rest("settings-sheet"))
    f.tap("重新检查")
    f.tap("icon:more")
    f.run_to(@kit.sheet_rest("settings-sheet"))
    f.tap("=重命名")
    f.run_to(@kit.sheet_rest("settings-sheet"))
    // (its field there and taking the typing: a scripted run's clear waits for it so)
    f.see("Profile 名称")
    f.clear()
    f.type_text("cc")
    f.tap("=保存")
    f.run_to(@kit.sheet_rest("settings-sheet"))
    f.see("=cc")
    f.back()
    f.run_to(@ui.nav_rest())
    f.see("=Profile")
    f.tap("icon:plus")
    f.run_to(@ui.nav_rest())
    f.see("选择服务商")
    f.tap("=Anthropic")
    f.tap("=API key")
    f.tap("验证可用后再添加")
    f.type_text("sk-ant-madeup-080726-0000000000")
    f.tap("验证并添加")
    f.back()
    f.run_to(@ui.nav_rest())
    // the page gone, its draft dropped (profile.flow.drop) as the frame after takes it away
    f.t.draw()
    f.end()
  })
}
