// 87-device-pages (e2e/traces/settings-device-pages.trace): 下方栏: Station's "−" on the first bar, then put in the
// second from its 添加, 密钥 taken off it first to make room (prefs.set barsBy); 本机缓存 (cache.usage); 关于 → 更新日志; 用量 → 价目表.

///|
test "87-device-pages" {
  @sfreplay.orders(fn(seed) {
    let f = @sfreplay.Flow::start(@sfreplay.trace("settings-device-pages"), seed~)
    f.tap("icon:settings")
    f.run_to(@ui.nav_rest)
    f.wheel_at("=设置", 500.0)
    // (what the wheel is for: 下方栏 come into the window)
    f.see("=下方栏")
    f.tap("=下方栏")
    f.run_to(@ui.nav_rest)
    f.see("第 1 栏")
    // Station's "−" (an icon, no words: by what it is called; where it is, a Mac's window has its buttons' band over a
    // phone's page, a phone none)
    f.tap("=从此栏移除Station")
    // (the second bar full as it comes (密钥 its fourth since #3400): room made in it, its own 添加 the one tapped, the
    // lower of the two)
    f.tap("=从此栏移除密钥")
    f.tap("=添加")
    f.run_to(@sf.presented_rest)
    f.see("添加到第 2 栏")
    f.tap("=Station")
    f.run_to(@sf.presented_rest)
    f.back()
    f.run_to(@ui.nav_rest)
    // (under the view's foot till then: the wheel above went as far as the list was counted then)
    f.wheel_at("=下方栏", 200.0)
    f.see("=本机缓存")
    f.tap("=本机缓存")
    f.run_to(@ui.nav_rest)
    // (the chats kept here, each by its title)
    f.see("端到端测试的对话")
    f.back()
    f.run_to(@ui.nav_rest)
    f.tap("=关于")
    f.run_to(@ui.nav_rest)
    f.tap("=更新日志")
    f.run_to(@ui.nav_rest)
    f.back()
    f.run_to(@ui.nav_rest)
    f.back()
    f.run_to(@ui.nav_rest)
    // (to its top: the account's row come into the window, its picture asked for only then, as it shows)
    f.wheel_at("=本机缓存", -700.0)
    f.see("Name of alice")
    // (then down to 用量, under the window's foot from there)
    f.wheel_at("=设置", 300.0)
    f.see("=用量")
    f.tap("=用量")
    f.run_to(@ui.nav_rest)
    f.tap("查看价目表")
    f.run_to(@ui.nav_rest)
    // (用量's days: its thumb a cover, placed where its choice is in the frame it shows, no motion of its own)
    f.see("=价目表")
    f.end()
  })
}
