import {
  "mbui/halt",
  "mbui/wasmrt",
  "moonbitlang/core/double",
  "stillfail/core",
  "stillfail/sfapp",
  "stillfail/sfapp/settings",
  "stillfail/sfcore",
  "stillfail/sfbase",
  "stillfail/sfkept",
  "mbui/ui",
  "mbui/view",
  "mbui/kit",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "mbui/runfs",
  "mbui/signals",
}

options(
  targets: {
    "emit_js.mbt": [ "js" ],
    "emit_native.mbt": [ "native" ],
    "trace_js.mbt": [ "js" ],
    "trace_native.mbt": [ "native" ],
    "emit_gc.mbt": [ "wasm-gc" ],
    "trace_gc.mbt": [ "wasm-gc" ],
    "emit_wasm.mbt": [ "wasm" ],
    "trace_wasm.mbt": [ "wasm" ],
  },
  "native-stub": [ "trace_files.c" ],
)
