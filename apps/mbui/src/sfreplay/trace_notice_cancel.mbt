conds, your estimate of how long until it does, and for, what you wait for. Waiting on a person is need_human.\n> - Otherwise: continue the work.","attachments":[],"quotes":[],"createdAt":1792489938956,"mine":false,"system":true,"reportable":true,"by":{"name":"still.fail"},"waiting":false,"time":{"createdAt":{"at":1792489938956,"ago":"刚刚","full":"10/20 17:52:18","until":"1 分钟内","past":true}}},{"seq":5,"thread":1,"ts":"1792489945.660000","authorKind":"person","author":"alice@example.test","authorName":"Name of alice","text":"打开就消失 083209 card:看一眼就行 083209|好 083209|不好 083209","attachments":[],"quotes":[],"createdAt":1792489945660,"mine":true,"system":false,"by":{"name":"Name of alice","picture":"https://example.test/p.png"},"waiting":false,"time":{"createdAt":{"at":1792489945660,"ago":"刚刚","full":"10/20 17:52:25","until":"1 分钟内","past":true}}},{"seq":6,"thread":1,"ts":"1792489945.698000","authorKind":"agent","author":"ember:c-275bed7e86","text":"看一眼就行 083209","attachments":[],"quotes":[],"declared":"block","ending":"need_help","createdAt":1792489945699,"mine":false,"system":false,"by":{"name":"默认模型","agent":"ember:c-275bed7e86","runtime":"claude","here":true},"waiting":false,"time":{"createdAt":{"at":1792489945699,"ago":"刚刚","full":"10/20 17:52:25","until":"1 分钟内","past":true}},"options":[{"label":"好 083209"},{"label":"不好 083209"}],"card":{"assigneeText":"待你决策","type":"options","options":[{"label":"好 083209"},{"label":"不好 083209"}]},"decision":{"resolved":false},"asked":true}],"elsewhere":[],"more":false,"newer":false,"at":5,"caught":6,"unreadLine":6,"unreadAbove":false,"outbox":[],"link":{"state":"online"},"offline":false,"pending":false,"decision":{"seq":6,"options":[{"label":"好 083209"},{"label":"不好 083209"}],"card":{"type":"options","options":[{"label":"好 083209"},{"label":"不好 083209"}]},"text":"奏 · 看一眼就行 083209"},"asks":[{"seq":6,"card":true,"mine":true,"text":"看一眼就行 083209"}],"publish":{"may":true,"links":[]}}},"w":1792489945837.549}
