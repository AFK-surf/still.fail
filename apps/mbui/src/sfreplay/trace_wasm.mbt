// Generated by mbui's scripts/wasmhost from trace_native.mbt: the file on classic Wasm, its C calls the native shell's
// imports (mbui/tools/wasmhost/main.mbt says how). Not to be edited: change trace_native.mbt and run scripts/wasmhost.
///|
fn mbw_sfr_trace_read(name : Int) -> Int = "mbhost" "sfr_trace_read"

///|
fn trace_bytes(name : Bytes) -> Bytes {
  @wasmrt.take_bytes(mbw_sfr_trace_read(@wasmrt.bytes_addr(name)))
}

///|
fn trace_found() -> Int = "mbhost" "sfr_trace_found"

///|
pub fn read_trace(name : String) -> String? {
  let b = trace_bytes(@utf8.encode(name))
  if trace_found() == 0 {
    None
  } else {
    Some(@utf8.decode_lossy(b[:]))
  }
}

