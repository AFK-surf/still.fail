import {
  "mbui/ui",
  "stillfail/sfapp",
}

import {
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "stillfail/sf",
  "stillfail/sfkept",
} for "wbtest"

options(
  targets: { "android_ref_env_js_wbtest.mbt": [ "js" ], "android_ref_env_native_wbtest.mbt": [ "native" ] },
  "pre-build": [
    {
      "input": "../../screens/text-mac.textrec",
      "output": "text_mac_wbtest.mbt",
      "command": ":embed -i $input -o $output --name text_mac_kept",
    },
    // still.fail's screens as the core's JSON gives them, both apps drawing each (scripts/android-ref.sh), and the
    // Android host's text as it recorded it for each (android_ref_wbtest.mbt; a new screen: one more here)
    {
      "input": "../../screens/text-android.textrec",
      "output": "text_android_wbtest.mbt",
      "command": ":embed -i $input -o $output --name text_android_kept",
    },
    // (the screens: written by scripts/screens-dump.sh from client/fixtures/screens)
    // screens: begin
    {
      "input": "../../../../client/fixtures/screens/blocked.json",
      "output": "screen_blocked_wbtest.mbt",
      "command": ":embed -i $input -o $output --name screen_blocked",
    },
    {
      "input": "../../../../client/fixtures/screens/chat.json",
      "output": "screen_chat_wbtest.mbt",
      "command": ":embed -i $input -o $output --name screen_chat",
    },
    {
      "input": "../../../../client/fixtures/screens/chat-attach.json",
