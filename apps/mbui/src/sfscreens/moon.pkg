import {
  "mbui/ui",
  "stillfail/sfapp",
}

import {
  "moonbitlang/core/test",
  "moonbitlang/core/json",
} for "wbtest"

options(
  targets: { "kept_js_wbtest.mbt": [ "js" ], "kept_native_wbtest.mbt": [ "native", "wasm", "wasm-gc", "llvm" ] },
  "pre-build": [
    {
      "input": "../../screens/text-mac.textrec",
      "output": "text_mac_wbtest.mbt",
      "command": ":embed -i $input -o $output --name text_mac_kept",
    },
  ],
)
