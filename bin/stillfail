#!/bin/sh
# still.fail's command line, from a clone or from an installed release (~/.stillfail/app, see cloud/src/install.ts).
#   stillfail start [--port N]                          runs the station (the release's service does this):
#                                                       stillfail-station, whose loopback port (4760, or a free one when
#                                                       that is taken; --port insists on one) sends links to the page it
#                                                       once had on to still.fail cloud
#   stillfail status                                    where the station is: its workspace and cloud, whether it is
#                                                       online, and why it does no work when it does none
#   stillfail update [--beta|--stable]                  updates this station to its cloud's latest release, on its
#                                                       channel (stable, or the test channel's), once its signature
#                                                       verifies; --beta/--stable puts it on that channel first (back to
#                                                       the stable release even when that is older than the beta it runs)
#   stillfail station enroll <cloud-origin> <token> [--provider comma] [--lock <hash>] [--join | --stay]
#                                                       joins a workspace in still.fail cloud (or in Comma), leaving
#                                                       those it is in; --join stays in them, --stay too when it is in
#                                                       one; --lock pins that workspace lock
#
#   stillfail station id
#   stillfail lock status|reset                         the workspace lock on this station: what is pinned, or taking
#                                                       it away (when every device that could sign is lost)
#   stillfail lock reset --workspace <id>               the lock of a workspace it joined, taken away alike
#   stillfail heap                                      a heap snapshot of the running station's main thread, written
#                                                       to <data>/run (only the latest kept; it holds the station's
#                                                       tokens): what its memory holds, for Chrome's DevTools
# The data is in $STILLFAIL_DATA, default ~/.stillfail.
set -eu
# Called through a link (~/.local/bin/stillfail): the app is where the link points.
self=$(readlink -f "$0" 2>/dev/null || echo "$0")
here=$(cd "$(dirname "$self")/.." && pwd)
# Called as another product's command (`monoid`: the installer links it so, client/i18n/brand.ts), that product's data
# directory (~/.monoid) beside still.fail's.
own=$HOME/.stillfail
case "$(basename "$0")" in stillfail|stillfail-*) ;; *) [ ! -d "$HOME/.$(basename "$0")/app" ] || own="$HOME/.$(basename "$0")" ;; esac
data=${STILLFAIL_DATA:-$own}
station=${STILLFAIL_STATION_BIN:-$here/mesh/target/release/stillfail-station}
case "${1:-} ${2:-}" in
  "start "*) shift; exec "$station" run --app "$here" --data "$data" "$@" ;;
  "update "*)
    # The channel's latest release, verified by this release's Node (the station's `update`: its signature, newer than
    # this one) and installed by the installer this release carries, told what it must hash to
    # (scripts/release-sign.ts). Not the cloud's installer: whoever serves it could put anything here.
    node=${STILLFAIL_NODE:-$here/node/bin/node}
    [ -x "$node" ] && [ -f "$here/station/main.js" ] || { echo "stillfail update: $here is not an installed release (no node/bin/node or station/main.js)" >&2; exit 1; }
    case "${2:-}" in --beta|--stable|"") ;; *) echo "usage: stillfail update [--beta|--stable]" >&2; exit 2 ;; esac
    shift
    plan=$("$node" "$here/station/main.js" update "$@" --app "$here" --data "$data") || exit $?
    script=""
    while IFS='=' read -r key value; do
      case $key in
        script) script=$value ;;
        STILLFAIL_ORIGIN|STILLFAIL_CHANNEL|STILLFAIL_RELEASE_SHA256|STILLFAIL_NODE_SHA256|STILLFAIL_INSTALL_LANG|STILLFAIL_ARCHIVE) export "$key=$value" ;;
      esac
    done <<PLAN
$plan
PLAN
    [ -n "$script" ] || { echo "stillfail update: no installer to run" >&2; exit 1; }
    STILLFAIL_DATA=$data exec sh "$script" ;;
  "station enroll") shift 2; exec "$station" enroll "$@" --data "$data" ;;
  "status "*|"station status") exec "$station" status --data "$data" ;;
  "station id") exec "$station" id --data "$data" ;;
  "lock status"|"lock reset") what=$2; shift 2; exec "$station" lock "$what" "$@" --data "$data" ;;
  "heap "*)
    node=${STILLFAIL_NODE:-$here/node/bin/node}
    [ -x "$node" ] && [ -f "$here/station/main.js" ] || { echo "stillfail heap: $here is not an installed release (no node/bin/node or station/main.js)" >&2; exit 1; }
    exec "$node" "$here/station/main.js" heap --data "$data" ;;
  *) echo "usage: stillfail start [--port N] | stillfail status | stillfail update [--beta|--stable] | stillfail station enroll <cloud-origin> <token> [--provider comma] [--lock <hash>] [--join | --stay] | stillfail station id | stillfail lock status | stillfail lock reset [--workspace <id>] | stillfail heap" >&2; exit 2 ;;
esac
