{
  "name": "@stillfail/core-ts",
  "private": true,
  "type": "module",
  "description": "The still.fail client core in TypeScript (docs/core-ts.md): the same protocol, data and words as client/core-ts",
  "scripts": {
    "check": "tsgo --noEmit",
    "shapes": "node scripts/shapes.ts",
    "build": "esbuild src/index.ts src/hosts/node.ts --outbase=src --bundle --platform=node --format=esm --target=node24 --outdir=dist --external:*.node",
    "test": "node ../../scripts/native.ts run mesh -- node --test --test-force-exit test/*.test.ts",
    "side": "node ../../scripts/native.ts run mesh iroh-relay -- node --test --test-force-exit side/*.test.ts",
    "hermes": "node scripts/hermes-bundle.ts"
  },
  "dependencies": {
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/bip39": "2.4.0",
    "decode-named-character-reference": "1.3.0",
    "effect": "4.0.0",
    "fzstd": "0.1.1",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm-strikethrough": "2.0.0",
    "mdast-util-gfm-table": "2.0.0",
    "mdast-util-gfm-task-list-item": "2.0.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "micromark-extension-gfm-table": "2.1.2",
    "micromark-extension-gfm-task-list-item": "2.1.0",
    "micromark-extension-math": "3.1.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.4",
    "@babel/plugin-transform-classes": "7.28.4",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "esbuild": "0.28.2",
    "micromark-util-types": "2.0.3"
  },
  "packageManager": "pnpm@10.33.0"
}
