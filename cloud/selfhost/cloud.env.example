# A self-hosted still.fail cloud's settings (README.md), read by ./run from the environment. Unset is unset: nothing of
# still.fail's hosted service's is the default of any of them.

# Its names, as the browser has them (Caddy in front ends TLS).
PUBLIC_ORIGIN=https://cloud.example.com
ADMIN_ORIGIN=https://admin.cloud.example.com
PREVIEW_ORIGIN=https://preview.cloud.example.com
# iroh-relay, served on a name of its own; more, comma-separated, in RELAY_URLS.
RELAY_URL=https://relay.cloud.example.com
#RELAY_URLS=

# Its keys (made once and kept: losing them signs everyone out and makes stations distrust new grants).
#   AUTH_SIGNING_KEY: 43 random characters or more; ADMIN_TOKEN: the same, the setup socket's and the scripts';
#   GRANT_SIGNING_JWK: an Ed25519 private JWK with a "kid" (README.md says how to make one).
AUTH_SIGNING_KEY=
ADMIN_TOKEN=
GRANT_SIGNING_JWK=

# The console's admin, and the owner of the workspace setup makes.
ADMIN_EMAIL=owner@example.com

# Signing in. With an email: EMAIL_FROM, and SMTP_URL to send through (smtp://user:password@host:587 with STARTTLS,
# smtps://user:password@host:465); without SMTP_URL the codes are written to the log.
EMAIL_FROM=noreply@cloud.example.com
#SMTP_URL=
#SMTP_HELO=cloud.example.com
# Through an OpenID provider (its client's redirect URI: $PUBLIC_ORIGIN/v1/auth/google/callback): Google's with
# OIDC_ISSUER unset, else OIDC_ISSUER's (a public client needs no secret).
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#OIDC_ISSUER=https://auth.example.com
#OIDC_NAME=Example SSO

# Where the API may connect (workerd's network rules: public, private, local, or CIDRs; comma-separated), and a PEM
# file of certificates to trust beside the browsers' roots (an OpenID provider's or an SMTP relay's own CA).
#OUTBOUND_ALLOW=public
#OUTBOUND_DENY=
#EXTRA_CA_CERTS=/etc/ssl/private-ca.pem
