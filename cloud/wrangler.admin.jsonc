{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The admin's console: static files only (dist/cloud-admin), on a host of its own; its /v1/ calls are the API's
  // route (wrangler.jsonc).
  "name": "ember-admin",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "admin.ember.3720.org", "custom_domain": true }],
  "assets": { "directory": "../dist/cloud-admin", "not_found_handling": "single-page-application" },
}
