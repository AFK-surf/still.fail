{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Template; deploy.py copies it to the ignored wrangler.local.json with the account id.
  "name": "ember-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Custom domains: wrangler creates each one's DNS record and certificate on deploy.
  "routes": [
    { "pattern": "ember.3720.org", "custom_domain": true },
    { "pattern": "admin.ember.3720.org", "custom_domain": true },
  ],
  "preview_urls": false,
  // Workers Logs: requests, errors and console output of the Worker and its Durable Objects, in the Cloudflare dashboard.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "PUBLIC_ORIGIN": "https://ember.3720.org",
    "ADMIN_ORIGIN": "https://admin.ember.3720.org",
    "GOOGLE_CLIENT_ID": "",
  },
  // The web app at the root, the admin's console under admin-app/. Every
  // request reaches the Worker first: which app a path belongs to depends on
  // the host, and each app's client-side routes fall back to its own
  // index.html (see index.ts), so no not-found handling here.
  "assets": {
    "directory": "../dist/cloud-app",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "containers": [{ "class_name": "Relay", "image": "./Dockerfile", "max_instances": 1, "instance_type": "lite" }],
  "durable_objects": {
    "bindings": [
      { "name": "RELAY_BUDGET", "class_name": "RelayBudget" },
      { "name": "RELAY", "class_name": "Relay" },
      { "name": "RECORDS", "class_name": "DiscoveryRecord" },
      { "name": "ACCOUNTS", "class_name": "Account" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "LOGINS", "class_name": "LoginAttempt" },
      { "name": "LOGIN_LIMITS", "class_name": "LoginLimiter" },
      { "name": "TELEMETRY_LIMITS", "class_name": "TelemetryLimiter" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Relay", "DiscoveryRecord", "Account", "Directory", "LoginAttempt", "LoginLimiter", "RelayBudget"] },
    { "tag": "v2", "new_sqlite_classes": ["TelemetryLimiter"] },
  ],
}
