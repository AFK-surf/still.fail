{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // still.fail cloud's API (src/index.ts). Template; deploy.py copies it to the ignored wrangler.local.json with the
  // account id. still.fail cloud is five Workers (deploy.py deploys each only when it changed):
  //   stillfail-cloud this one: the API, on the paths below
  //   ember-relay    the relay (wrangler.relay.jsonc)
  //   stillfail-web      the web app, static, on PUBLIC_ORIGIN's Custom Domain (wrangler.web.jsonc)
//   stillfail-web-beta the same files, on BETA_ORIGIN's: the test channel (wrangler.web-beta.jsonc)
  //   stillfail-admin    the admin's console, static, on ADMIN_ORIGIN's (wrangler.admin.jsonc)
  //   stillfail-preview  the preview host, static, on PREVIEW_ORIGIN's (wrangler.preview.jsonc)
  // A route takes precedence over a Custom Domain on the same host, so the API's and the relay's paths reach their
  // Workers and every other path the static ones.
  // Each host has its new name (still.fail) and its old one (3720.org), both bound for good (docs/rename-still-fail.md):
  // PUBLIC_ORIGIN and ADMIN_ORIGIN are the new ones, which every link is made with; the *_ALIASES the old ones,
  // answered the same (src/compat.ts). migrate-workers.py transfers existing Durable Objects before a Worker rename;
  // namespace IDs and signing keys must remain unchanged. The release bucket migrates separately.
  "name": "stillfail-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "app.still.fail/v1/*", "zone_name": "still.fail" },
    { "pattern": "admin.still.fail/v1/*", "zone_name": "still.fail" },
    { "pattern": "app.still.fail/healthz*", "zone_name": "still.fail" },
    { "pattern": "app.still.fail/install.sh*", "zone_name": "still.fail" },
    { "pattern": "app.still.fail/releases/*", "zone_name": "still.fail" },
    { "pattern": "app.still.fail/.well-known/*", "zone_name": "still.fail" },
    // The test channel's host, on its own domain (youdid.wtf, the dual of still.fail): the same API (index.ts gates it to
    // the accounts let in). deploy.py leaves these out while the youdid.wtf zone is not on Cloudflare.
    { "pattern": "app.youdid.wtf/v1/*", "zone_name": "youdid.wtf" },
    { "pattern": "app.youdid.wtf/healthz*", "zone_name": "youdid.wtf" },
    { "pattern": "app.youdid.wtf/install.sh*", "zone_name": "youdid.wtf" },
    { "pattern": "app.youdid.wtf/releases/*", "zone_name": "youdid.wtf" },
    { "pattern": "app.youdid.wtf/.well-known/*", "zone_name": "youdid.wtf" },
    { "pattern": "ember.3720.org/v1/*", "zone_name": "3720.org" },
    { "pattern": "admin.ember.3720.org/v1/*", "zone_name": "3720.org" },
    { "pattern": "ember.3720.org/healthz*", "zone_name": "3720.org" },
    { "pattern": "ember.3720.org/install.sh*", "zone_name": "3720.org" },
    { "pattern": "ember.3720.org/releases/*", "zone_name": "3720.org" },
    { "pattern": "ember.3720.org/.well-known/*", "zone_name": "3720.org" },
  ],
  "preview_urls": false,
  // Workers Logs: requests, errors and console output of the Worker and its Durable Objects, in the Cloudflare dashboard.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "PUBLIC_ORIGIN": "https://app.still.fail",
    "PUBLIC_ORIGIN_ALIASES": "https://ember.3720.org",
    "ADMIN_ORIGIN": "https://admin.still.fail",
    "ADMIN_ORIGIN_ALIASES": "https://admin.ember.3720.org",
    // The web app's test channel (stillfail-web-beta); removing it turns the channel off (its calls answer 421).
    "BETA_ORIGIN": "https://app.youdid.wtf",
    // Relays beside still.fail's own (src/relays.ts): one in Beijing (Alibaba Cloud, by its IP: no ICP filing), for
    // stations and devices in mainland China, where Cloudflare's is slow or out of reach; one in Hong Kong (Alibaba
    // Cloud, on a line tuned for the mainland), near enough to both the mainland and abroad.
    "RELAY_URLS": "https://39.105.157.122,https://47.76.247.168",
    // What they are called on a station's card (经中继北京).
    "RELAY_NAMES": { "https://app.still.fail": "Cloudflare", "https://39.105.157.122": "北京", "https://47.76.247.168": "香港" },
    "GOOGLE_CLIENT_ID": "",
    // The operator console's one Google account (src/admin.ts); replace it when deploying your own.
    "ADMIN_EMAIL": "zuozijian1994@gmail.com",
  },
  // The stations' releases (scripts/release.sh puts them, install.sh gets them from /releases/).
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "stillfail-releases" }],
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNTS", "class_name": "Account" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "LOGINS", "class_name": "LoginAttempt" },
      { "name": "LOGIN_LIMITS", "class_name": "LoginLimiter" },
      { "name": "TELEMETRY_LIMITS", "class_name": "TelemetryLimiter" },
    ],
  },
  // Fresh installs create these. Existing production namespaces were transferred with the same
  // stillfail-v1 tag by migrate-workers.py before route cutover; never replay the old Worker's migrations here.
  "migrations": [
    { "tag": "stillfail-v1", "new_sqlite_classes": ["Account", "Directory", "LoginAttempt", "LoginLimiter", "TelemetryLimiter"] },
  ],
}
