{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The component library's page (apps/mbui/src/sfstories: each part of apps/mbui/src/sf beside its states), static,
  // built by apps/mbui/scripts/kit-web.sh into dist/kit. monoid's alone (the user, 2026-11-13: on monoid.zone): CI
  // deploys it with STILLFAIL_CLOUD=monoid, which names youdid.wtf's hosts monoid.zone's (deploy.py rehost), never to
  // still.fail's account.
  "name": "stillfail-kit",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "kit.youdid.wtf", "custom_domain": true }],
  "assets": { "directory": "../dist/kit", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
}
