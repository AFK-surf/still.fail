{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The preview host (src/preview.ts): static files only (build-static.ts → dist/cloud-preview), headers in its
  // _headers, anything else its 404.html. On its new host and its old one (kept: clients from before the rename open
  // it). Its old custom domain remains an alias.
  "name": "stillfail-preview",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "preview.still.fail", "custom_domain": true },
    { "pattern": "preview.ember.3720.org", "custom_domain": true },
  ],
  "assets": { "directory": "../dist/cloud-preview", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" },
}
