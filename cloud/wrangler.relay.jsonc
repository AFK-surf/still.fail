{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // still.fail's relay (src/relay-worker.ts), a Worker of its own so deploying the rest of still.fail cloud drops no
  // relay connection. Its paths are routes on PUBLIC_ORIGIN's host and on its old one, PUBLIC_ORIGIN_ALIASES (see
  // wrangler.jsonc). Existing installations transfer namespaces before deploying this configuration.
  // The container application keeps its explicit identity until a separate container rollout retires it.
  "name": "stillfail-relay",
  "main": "src/relay-worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "app.still.fail/relay*", "zone_name": "still.fail" },
    { "pattern": "app.still.fail/ping*", "zone_name": "still.fail" },
    { "pattern": "app.still.fail/generate_204*", "zone_name": "still.fail" },
    { "pattern": "app.still.fail/v1/admin/relay/*", "zone_name": "still.fail" },
    { "pattern": "ember.3720.org/relay*", "zone_name": "3720.org" },
    { "pattern": "ember.3720.org/ping*", "zone_name": "3720.org" },
    { "pattern": "ember.3720.org/generate_204*", "zone_name": "3720.org" },
    { "pattern": "ember.3720.org/v1/admin/relay/*", "zone_name": "3720.org" },
  ],
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": { "PUBLIC_ORIGIN": "https://app.still.fail", "PUBLIC_ORIGIN_ALIASES": "https://ember.3720.org" },
  "containers": [{ "name": "ember-relay-relay", "class_name": "Relay", "image": "./Dockerfile", "max_instances": 1, "instance_type": "lite" }],
  "durable_objects": {
    "bindings": [
      { "name": "RELAY_BUDGET", "class_name": "RelayBudget" },
      { "name": "RELAY", "class_name": "Relay" },
    ],
  },
  "migrations": [{ "tag": "stillfail-v1", "new_sqlite_classes": ["Relay", "RelayBudget"] }],
}
