{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // ember's web app: static files only (`pnpm run build:cloud` → dist/cloud-web), no code. Its client-side routes
  // fall back to index.html. The API's and the relay's paths on this host are routes of their own (wrangler.jsonc).
  "name": "ember-web",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ember.3720.org", "custom_domain": true }],
  "assets": { "directory": "../dist/cloud-web", "not_found_handling": "single-page-application" },
}
