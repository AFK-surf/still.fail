{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // still.fail's web app: static files only (`pnpm run build:cloud` → dist/cloud-web), no code. Its client-side routes
  // fall back to index.html. The API's and the relay's paths on this host are routes of their own (wrangler.jsonc).
  // On its new host and its old one (kept for good, not redirected: links already sent point there). The Worker keeps
  // its name from before the rename (renaming would make a new Worker).
  "name": "ember-web",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "app.still.fail", "custom_domain": true },
    { "pattern": "ember.3720.org", "custom_domain": true },
  ],
  "assets": { "directory": "../dist/cloud-web", "not_found_handling": "single-page-application" },
}
