# Chinese through the input method (composed, then committed), Enter a new line, not a send.
timeout 60000
tap 端到端测试
until =studio
until 发消息
wait 1000
# (on Android the emulator's keyboard is turned off for this: it ends any composition it did not make itself)
log do: android-ime off
wait 2000
tap 发消息
wait 500
mark ni'hao
shot 1-composing
type 你好
enter
mark di'er'hang
shot 2-composing-second-line
type 第二行 {T}
field 你好\n第二行 {T}
shot 3-two-lines
tap icon:arrow-up
until 第二行 {T}
gone 正在发送
shot 4-sent
log do: android-ime on
wait 1500
