check "the station has the message with its four files" 'a=$(entry_attachments "四个文件 $TAG"); echo "$a" | grep -q e2e-photo.jpg && echo "$a" | grep -q e2e-doc.pdf && echo "$a" | grep -q e2e-clip.mp4 && echo "$a" | grep -q e2e-page.html'
check "the picture was read whole through the core and shown" 'grep -q "preview: .*e2e-photo.jpg read whole through the core" $OUT/$name.log && python3 $D/pngstat.py $OUT/$name/1-image.png 0.1 0.3 0.9 0.7 20'
check "the PDF was read through the core, its 2 pages drawn by the system" 'grep -q "preview: .*e2e-doc.pdf: a PDF of 2 pages" $OUT/$name.log && python3 $D/pngstat.py $OUT/$name/2-pdf.png 0.1 0.15 0.9 0.6 3'
check "the player read the video through the core (station.file.part), a part at a time" 'grep -q "preview: .*e2e-clip.mp4 @0 [0-9]* bytes through the core (station.file.part" $OUT/$name.log && grep -q "view [0-9]*: read" $OUT/$name.log'
check "the player showed its frames" 'grep -q "view [0-9]*: first frame shown" $OUT/$name.log && python3 $D/pngstat.py $OUT/$name/3-video.png 0.1 0.35 0.9 0.6 20'
check "the page was read through the core and loaded in a web view" 'grep -q "preview: .*e2e-page.html read whole through the core" $OUT/$name.log && grep -q "view [0-9]*: page loaded" $OUT/$name.log && python3 $D/pngstat.py $OUT/$name/4-page.png 0.05 0.12 0.95 0.5 3'
