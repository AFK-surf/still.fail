check "what was shared went into the chat's composer through the core (shareIn.open) and was sent as its words" 'grep -q "CALL shareIn.open" $OUT/$name.log && [ "$(sql "select count(*) from entries where author=\"alice@example.test\" and text like \"%列表视频$TAG%youtube.com/watch?v=e2e$TAG%\"")" -ge 1 ]'
check "the drive's file was read through the core and handed to the system's share sheet (on Android, the chooser on screen)" 'if [ $PLATFORM = android ]; then sleep 4; $ADB exec-out screencap -p > $OUT/$name/4-shared.png; $ADB logcat -d > $OUT/$name/logcat.txt; grep -q "share: 说明.txt (" $OUT/$name/logcat.txt && $ADB shell dumpsys activity activities | grep -q "ChooserActivity\|ResolverActivity\|intentresolver"; else grep -q "share: a file to the system" $OUT/$name.log; fi'
check "on Android, a share from another app (an intent) is taken in" '[ $PLATFORM != android ] || ( $ADB logcat -c; $ADB shell am start -a android.intent.action.SEND -t text/plain --es android.intent.extra.TEXT "e2e-$TAG" --es env "MBUI_CLOUD=$MBUI_CLOUD" -n $E2E_PKG/dev.mbui.MainActivity >/dev/null && sleep 4 && $ADB logcat -d -s mbui:I | grep -q "shared in: "; r=$?; $ADB shell am force-stop $E2E_PKG; [ $r = 0 ] )'
