///|
test "made: characters of 2, 3 and 4 bytes, in a name, an id and data" {
  made(81, b"id: \xc3\xa9\n\n", [{ name: "", data: "", id: Some("\u{e9}") }])
  made(82, b"id:\xe9\x95\xbf\n\n", [{ name: "", data: "", id: Some("\u{957f}") }])
  made(83, b"id:\xf0\x9f\x98\x80\n\n", [{ name: "", data: "", id: Some("\u{1f600}") }])
  made(84, b"data:\xc3\xa9\n\n", [{ name: "message", data: "\u{e9}", id: None }])
  made(85, b"data: \xe9\x95\xbf\xe9\x95\xbf\n\n", [{ name: "message", data: "\u{957f}\u{957f}", id: None }])
  made(86, b"data:\xf0\x9f\x98\x80\n\n", [{ name: "message", data: "\u{1f600}", id: None }])
  made(87, b"event:\xf0\x9f\x98\x80\ndata: \xf0\x9f\x98\x80\n\n", [{ name: "\u{1f600}", data: "\u{1f600}", id: None }])
  made(88, b"id: \xf0\x9f\x98\x80 \xe3\x80\x80\n\n", [{ name: "", data: "", id: Some("\u{1f600}") }])
  made(89, b"event: \xf0\x9f\x98\x80x\xf0\x9f\x98\x80\t\nid:\xf0\x9f\x98\x80\n\n", [{ name: "", data: "", id: Some("\u{1f600}") }])
  made(90, b"event: \xc3\xa9\xe9\x95\xbf\xf0\x9f\x98\x80\nid: \xf0\x9f\x98\x80\xe9\x95\xbf\xc3\xa9\ndata: {\"text\":\"\xe6\x95\xb4\xe7\x90\x86\xc3\xa9\xf0\x9f\x98\x80\"}\n\n", [{ name: "\u{e9}\u{957f}\u{1f600}", data: "{\"text\":\"\u{6574}\u{7406}\u{e9}\u{1f600}\"}", id: Some("\u{1f600}\u{957f}\u{e9}") }])
}

///|
test "made: CRs: after a line, alone, in runs, in a field's name, for a blank line" {
  made(91, b"data: x\r\n\r\n", [{ name: "message", data: "x", id: None }])
  made(92, b"data: x\r\r\n\r\n", [{ name: "message", data: "x", id: None }])
  made(93, b"data: x\n\r\n", [{ name: "message", data: "x", id: None }])
  made(94, b"data: x\rdata: y\r\r", [])
  made(95, b"\r\r\r", [])
  made(96, b"\r\n\r\n", [])
  made(97, b"data: a\rb\n\n", [{ name: "message", data: "ab", id: None }])
  made(98, b"da\rta: x\n\n", [{ name: "message", data: "x", id: None }])
  made(99, b"\rdata: x\n\r\n\r", [{ name: "message", data: "x", id: None }])
  made(100, b"event: e\r\nid: 1\r\ndata: x\r\n\r\ndata: y\r\n\r\n", [{ name: "e", data: "x", id: Some("1") }, { name: "message", data: "y", id: None }])
  made(101, b"id: 1\r\n\r", [])
  made(102, b"data: x\n\r\r\r\ndata: y\n\n", [{ name: "message", data: "x", id: None }, { name: "message", data: "y", id: None }])
}

///|
test "made: a byte order mark: at a stream's head, at a later block's, in a line, twice, cut short, with CRs in it" {
  made(103, b"\xef\xbb\xbfdata: x\n\n", [{ name: "message", data: "x", id: None }])
  made(104, b"\xef\xbb\xbf\xef\xbb\xbfdata: x\n\n", [])
  made(105, b"data: x\n\n\xef\xbb\xbfevent: e\ndata: y\n\n", [{ name: "message", data: "x", id: None }, { name: "e", data: "y", id: None }])
  made(106, b"\xef\xbb\xbfid: 1\n\n", [{ name: "", data: "", id: Some("1") }])
  made(107, b"\xef\xbb\xbf\n\n", [])
  made(108, b"data: \xef\xbb\xbfx\n\n", [{ name: "message", data: "\u{feff}x", id: None }])
  made(109, b"id:\xef\xbb\xbf\n\n", [{ name: "", data: "", id: Some("") }])
  made(110, b"event:\xef\xbb\xbf\ndata:x\n\n", [{ name: "", data: "x", id: None }])
  made(111, b"id: 3\xef\xbb\xbf\n\n", [{ name: "", data: "", id: Some("3") }])
  made(112, b"\xef\xbb\xbf\ndata: x\n\n", [{ name: "message", data: "x", id: None }])
  made(113, b"\n\xef\xbb\xbfdata: x\n\n", [])
  made(114, b"data: a\n\xef\xbb\xbfdata: b\n\n", [{ name: "message", data: "a", id: None }])
  made(115, b"\xef\xbbdata: x\n\n", [])
  made(116, b"\xefdata: x\n\n", [])
  made(117, b"\xef\xbb\xbf\xef\xbb\ndata: x\n\n", [{ name: "message", data: "x", id: None }])
  made(118, b"\xff\xfedata: x\n\n", [])
  made(119, b"\xef\xbb\xbf\r\ndata: x\r\n\r\n", [{ name: "message", data: "x", id: None }])
  made(120, b"\xef\r\xbb\r\xbfdata: x\n\n", [{ name: "message", data: "x", id: None }])
  made(121, b"\xef\xbb\r\xbfid: 1\n\n", [{ name: "", data: "", id: Some("1") }])
}

///|
test "made: bytes that are no UTF-8, of each kind: in data, at a block's end, at its head, in an id and a name, twice" {
  made(122, b"data: a\x80b\n\n", [{ name: "message", data: "a\u{fffd}b", id: None }])
  made(123, b"data: a\x80\n\ndata: z\n\n", [{ name: "message", data: "a\u{fffd}", id: None }, { name: "message", data: "z", id: None }])
  made(124, b"\x80data: a\n\n\x80\n\n", [])
  made(125, b"id:\x80\n\nevent:\x80 \ndata:\x80\n\n", [{ name: "", data: "", id: Some("\u{fffd}") }, { name: "\u{fffd}", data: "\u{fffd}", id: None }])
  made(126, b"data: \x80\x80\n\n", [{ name: "message", data: "\u{fffd}\u{fffd}", id: None }])
  made(127, b"data: a\xbfb\n\n", [{ name: "message", data: "a\u{fffd}b", id: None }])
  made(128, b"data: a\xbf\n\ndata: z\n\n", [{ name: "message", data: "a\u{fffd}", id: None }, { name: "message", data: "z", id: None }])
  made(129, b"\xbfdata: a\n\n\xbf\n\n", [])
  made(130, b"id:\xbf\n\nevent:\xbf \ndata:\xbf\n\n", [{ name: "", data: "", id: Some("\u{fffd}") }, { name: "\u{fffd}", data: "\u{fffd}", id: None }])
  made(131, b"data: \xbf\xbf\n\n", [{ name: "message", data: "\u{fffd}\u{fffd}", id: None }])
  made(132, b"data: a\xc0\x80b\n\n", [{ name: "message", data: "a\u{fffd}\u{fffd}b", id: None }])
  made(133, b"data: a\xc0\x80\n\ndata: z\n\n", [{ name: "message", data: "a\u{fffd}\u{fffd}", id: None }, { name: "message", data: "z", id: None }])
  made(134, b"\xc0\x80data: a\n\n\xc0\x80\n\n", [])
