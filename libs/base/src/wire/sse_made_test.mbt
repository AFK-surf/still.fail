// Made by scripts/mb-base-sse.ts: do not edit. Each case is a stream and the events the device base's reader in
// TypeScript (client/core-ts/src/sse.ts, run by Node, with the WHATWG's TextDecoder) gives for it. The reader here is
// to give the same, the stream fed whole, a byte at a time and cut in two (`fed`: wire_test.mbt), on each target. A
// reading meant to change is changed in both readers; a stream is added in the script; then this is made again:
// node scripts/mb-base-sse.ts.

///|
/// `stream` reads as `want` however it is fed; `n` says which case did not.
fn made(n : Int, stream : Bytes, want : Array[@wire.Event]) -> Unit raise {
  let ways : Array[(String, Array[Int])] = [
    ("whole", []),
    ("a byte at a time", Array::makei(stream.length() - 1, i => i + 1)),
    ("cut in two", [stream.length() / 2]),
  ]
  for way in ways {
    if fed(stream, way.1) != want {
      fail("case \{n}, fed \{way.0}: \{stream}")
    }
  }
}

///|
test "made: a field with no space, with spaces alone, with no colon, with nothing; several of one; what is no field" {
  made(1, b"data:\n\n", [{ name: "message", data: "", id: None }])
  made(2, b"data: \n\n", [{ name: "message", data: "", id: None }])
  made(3, b"data:  \n\n", [{ name: "message", data: " ", id: None }])
  made(4, b"data:   \n\n", [{ name: "message", data: "  ", id: None }])
  made(5, b"data\n\n", [])
  made(6, b"data:x\n\n", [{ name: "message", data: "x", id: None }])
  made(7, b"data:  x \n\n", [{ name: "message", data: " x ", id: None }])
  made(8, b"data:\ndata:\n\n", [{ name: "message", data: "\n", id: None }])
  made(9, b"data: a\ndata:\ndata: b\n\n", [{ name: "message", data: "a\n\nb", id: None }])
  made(10, b"data: one\ndata: two\ndata: three\n\n", [{ name: "message", data: "one\ntwo\nthree", id: None }])
  made(11, b"id:\n\n", [{ name: "", data: "", id: Some("") }])
  made(12, b"id: \n\n", [{ name: "", data: "", id: Some("") }])
  made(13, b"id:   \n\n", [{ name: "", data: "", id: Some("") }])
  made(14, b"id\n\n", [])
  made(15, b"id:7\n\n", [{ name: "", data: "", id: Some("7") }])
  made(16, b"id:7\ndata:\n\n", [{ name: "message", data: "", id: Some("7") }])
  made(17, b"id: a\nid: b\n\n", [{ name: "", data: "", id: Some("b") }])
  made(18, b"id: a\nid:\ndata: x\n\n", [{ name: "message", data: "x", id: Some("") }])
  made(19, b"event:\n\n", [])
  made(20, b"event: \n\n", [])
  made(21, b"event:x\n\n", [])
  made(22, b"event:\ndata:x\n\n", [{ name: "", data: "x", id: None }])
  made(23, b"event:   \ndata:x\n\n", [{ name: "", data: "x", id: None }])
  made(24, b"event: a\nevent: b\ndata: x\n\n", [{ name: "b", data: "x", id: None }])
  made(25, b"event: a b \ndata: x\n\n", [{ name: "a b", data: "x", id: None }])
  made(26, b"event:  e \ndata: x\n\n", [{ name: "e", data: "x", id: None }])
  made(27, b"event: e\nid: 1\ndata: x\n\n", [{ name: "e", data: "x", id: Some("1") }])
  made(28, b"data: x\nid: 1\nevent: e\n\n", [{ name: "e", data: "x", id: Some("1") }])
  made(29, b"Data: x\n\n", [])
  made(30, b" data: x\n\n", [])
  made(31, b"data : x\n\n", [])
  made(32, b"data:x:y\n\n", [{ name: "message", data: "x:y", id: None }])
  made(33, b":comment\n\n", [])
  made(34, b": a comment\nid: 4\n\n", [{ name: "", data: "", id: Some("4") }])
  made(35, b"retry: 5\ndata: x\n\n", [{ name: "message", data: "x", id: None }])
  made(36, b"retry: 5\n\n", [])
  made(37, b"data: a\x00b\n\n", [{ name: "message", data: "a\u{0}b", id: None }])
  made(38, b"id: \x00\n\n", [{ name: "", data: "", id: Some("\u{0}") }])
  made(39, b"event:\x00\ndata:\x00\n\n", [{ name: "\u{0}", data: "\u{0}", id: None }])
  made(40, b"\x00data: x\n\n", [])
}

///|
test "made: blank lines before, between and after blocks; a block that is not ended" {
  made(41, b"\n\n", [])
  made(42, b"\n\n\n\n", [])
  made(43, b"\n\n\n", [])
  made(44, b"\ndata: x\n\n", [{ name: "message", data: "x", id: None }])
  made(45, b"\n\n\ndata: x\n\n", [{ name: "message", data: "x", id: None }])
  made(46, b"data: x\n\n\n\n", [{ name: "message", data: "x", id: None }])
  made(47, b"data: x\n\n\ndata: y\n\n", [{ name: "message", data: "x", id: None }, { name: "message", data: "y", id: None }])
  made(48, b"data: x\n", [])
  made(49, b"data: x\n\ndata: y", [{ name: "message", data: "x", id: None }])
  made(50, b"data: x\n\nid: 2\n", [{ name: "message", data: "x", id: None }])
}

