  made(52, b"event:\x0bn\x0b\nid:\x0bi\x0b\ndata:\x0bd\x0b\n\nid:\x0b\n\n", [{ name: "n", data: "\u{b}d\u{b}", id: Some("i") }, { name: "", data: "", id: Some("") }])
  made(53, b"event:\x0cn\x0c\nid:\x0ci\x0c\ndata:\x0cd\x0c\n\nid:\x0c\n\n", [{ name: "n", data: "\u{c}d\u{c}", id: Some("i") }, { name: "", data: "", id: Some("") }])
