///|
test "absolute_layout_column_reverse_margin_border" {
  let root = @flex.Node::new()
  root.style.position = Absolute
  root.style.set_width(Pt(200.0))
  root.style.set_height(Pt(200.0))
  root.style.direction = ColumnReverse
  let root_child0 = @flex.Node::new()
  root_child0.style.position = Absolute
  root_child0.style.set_width(Pt(50.0))
  root_child0.style.set_height(Pt(50.0))
  root_child0.style.set_inset_left(Pt(5.0))
  root_child0.style.set_inset_right(Pt(3.0))
  root_child0.style.set_margin_right(Pt(4.0))
  root_child0.style.set_margin_left(Pt(3.0))
  root_child0.style.set_border_right(Pt(7.0))
  root_child0.style.set_border_left(Pt(1.0))
  root.add(root_child0)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 200.0, 200.0)
  check("root_child0", root_child0, 8.0, 150.0, 50.0, 50.0)
}
