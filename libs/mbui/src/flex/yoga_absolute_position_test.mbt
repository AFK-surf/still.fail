///|
test "absolute_layout_padding" {
  let root = @flex.Node::new()
  root.style.position = Absolute
  let root_child0 = @flex.Node::new()
  root_child0.style.set_width(Pt(200.0))
  root_child0.style.set_height(Pt(200.0))
  root_child0.style.set_margin_left(Pt(10.0))
  root_child0.style.set_margin_top(Pt(10.0))
  root_child0.style.set_margin_right(Pt(10.0))
  root_child0.style.set_margin_bottom(Pt(10.0))
  root.add(root_child0)
  let root_child0_child0 = @flex.Node::new()
  root_child0_child0.style.position = Static
  root_child0_child0.style.set_width(Pt(200.0))
  root_child0_child0.style.set_height(Pt(200.0))
  root_child0_child0.style.set_padding_left(Pt(50.0))
  root_child0_child0.style.set_padding_top(Pt(50.0))
  root_child0_child0.style.set_padding_right(Pt(50.0))
  root_child0_child0.style.set_padding_bottom(Pt(50.0))
  root_child0.add(root_child0_child0)
  let root_child0_child0_child0 = @flex.Node::new()
  root_child0_child0_child0.style.position = Absolute
  root_child0_child0_child0.style.set_width(Pt(50.0))
  root_child0_child0_child0.style.set_height(Pt(50.0))
  root_child0_child0.add(root_child0_child0_child0)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 220.0, 220.0)
  check("root_child0", root_child0, 10.0, 10.0, 200.0, 200.0)
  check("root_child0_child0", root_child0_child0, 0.0, 0.0, 200.0, 200.0)
  check("root_child0_child0_child0", root_child0_child0_child0, 50.0, 50.0, 50.0, 50.0)
}

