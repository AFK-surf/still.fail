///|
test "static_position_static_root" {
  let root = @flex.Node::new()
  root.style.set_height(Pt(200.0))
  root.style.set_width(Pt(100.0))
  root.style.position = Static
  root.style.set_padding_top(Pt(1.0))
  root.style.set_padding_right(Pt(11.0))
  root.style.set_padding_bottom(Pt(4.0))
  root.style.set_padding_left(Pt(6.0))
  let root_child0 = @flex.Node::new()
  root_child0.style.set_height(Pct(50.0))
  root_child0.style.set_width(Pct(50.0))
  root_child0.style.position = Absolute
  root_child0.style.set_border_top(Pt(3.0))
  root_child0.style.set_border_right(Pt(2.0))
  root_child0.style.set_border_bottom(Pt(1.0))
  root_child0.style.set_border_left(Pt(4.0))
  root_child0.style.set_padding_top(Pt(7.0))
  root_child0.style.set_padding_right(Pt(5.0))
  root_child0.style.set_padding_bottom(Pt(4.0))
  root_child0.style.set_padding_left(Pt(3.0))
  root_child0.style.set_margin_top(Pt(11.0))
  root_child0.style.set_margin_right(Pt(15.0))
  root_child0.style.set_margin_bottom(Pt(1.0))
  root_child0.style.set_margin_left(Pt(12.0))
  root.add(root_child0)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 100.0, 200.0)
  check("root_child0", root_child0, 18.0, 12.0, 50.0, 100.0)
}

