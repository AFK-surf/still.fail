test "static_position_insets_have_no_effect_left_top" {
  let root = @flex.Node::new()
  root.style.position = Absolute
  let root_child0 = @flex.Node::new()
  root_child0.style.set_width(Pt(100.0))
  root_child0.style.set_height(Pt(100.0))
  root_child0.style.position = Static
  root_child0.style.set_inset_top(Pt(50.0))
  root_child0.style.set_inset_left(Pt(50.0))
  root.add(root_child0)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 100.0, 100.0)
  check("root_child0", root_child0, 0.0, 0.0, 100.0, 100.0)
}

