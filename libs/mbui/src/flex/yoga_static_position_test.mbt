  let root_child0_child0_child0 = @flex.Node::new()
  root_child0_child0_child0.style.set_height(Pt(50.0))
  root_child0_child0_child0.style.set_width(Pct(10.0))
  root_child0_child0_child0.style.position = Absolute
  root_child0_child0.add(root_child0_child0_child0)
  let root_child0_child1 = @flex.Node::new()
  root_child0_child1.style.set_height(Pt(100.0))
  root_child0_child1.style.set_width(Pt(100.0))
  root_child0_child1.style.position = Static
  root_child0.add(root_child0_child1)
  let root_child0_child1_child0 = @flex.Node::new()
  root_child0_child1_child0.style.set_height(Pt(50.0))
  root_child0_child1_child0.style.set_width(Pct(50.0))
  root_child0_child1_child0.style.position = Absolute
  root_child0_child1.add(root_child0_child1_child0)
  let root_child0_child1_child1 = @flex.Node::new()
  root_child0_child1_child1.style.set_height(Pt(50.0))
  root_child0_child1_child1.style.set_width(Pct(50.0))
  root_child0_child1_child1.style.position = Absolute
  root_child0_child1.add(root_child0_child1_child1)
  let root_child0_child2 = @flex.Node::new()
  root_child0_child2.style.set_height(Pt(50.0))
  root_child0_child2.style.set_width(Pt(25.0))
  root_child0_child2.style.position = Absolute
  root_child0.add(root_child0_child2)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 400.0, 400.0)
  check("root_child0", root_child0, 0.0, 0.0, 400.0, 400.0)
  check("root_child0_child0", root_child0_child0, 100.0, 100.0, 100.0, 100.0)
  check("root_child0_child0_child0", root_child0_child0_child0, 0.0, 0.0, 40.0, 50.0)
  check("root_child0_child1", root_child0_child1, 100.0, 200.0, 100.0, 100.0)
  check("root_child0_child1_child0", root_child0_child1_child0, 0.0, 0.0, 200.0, 50.0)
  check("root_child0_child1_child1", root_child0_child1_child1, 0.0, 0.0, 200.0, 50.0)
  check("root_child0_child2", root_child0_child2, 100.0, 100.0, 25.0, 50.0)
}
