///|
let mbw_cb_mb_host_run_5 : Ref[FuncRef[(Int, String, Int, Int) -> Unit]?] = Ref(None)

///|
fn mbw_cb_mb_host_run_5_in(a0 : Int, a1 : Int, a2 : Int, a3 : Int) -> Unit {
  match mbw_cb_mb_host_run_5.val {
    Some(f) => f(a0, @wasmrt.string_at(a1), a2, a3)
    None => @halt.saying("mb_host_run: no function")
  }
}

///|
fn mbw_mb_host_run(title : Int, frame : FuncRef[(Double, Double, Double, Double) -> Unit], pointer : FuncRef[(Int, Double, Double, Int) -> Unit], wheel : FuncRef[(Double, Double, Double, Double, Int) -> Unit], key : FuncRef[(Int, Int) -> Unit], text : FuncRef[(Int, Int, Int, Int) -> Unit]) = "mbhost" "mb_host_run"

///|
