// Generated by mbui's scripts/wasmhost from terminal_native.mbt: the file on classic Wasm, its C calls the native shell's
// imports (mbui/tools/wasmhost/main.mbt says how). Not to be edited: change terminal_native.mbt and run scripts/wasmhost.
// terminal.mbt's calls on a native host (term.h, which each host's C includes).

///|
fn tm_open(cols : Int, rows : Int) -> Int = "mbhost" "mb_host_term_open"

///|
fn mbw_mb_host_term_write(id : Int, data : Int) = "mbhost" "mb_host_term_write"

///|
fn tm_write(id : Int, data : Bytes) -> Unit {
  mbw_mb_host_term_write(id, @wasmrt.bytes_addr(data))
}

///|
fn tm_resize(id : Int, cols : Int, rows : Int) = "mbhost" "mb_host_term_resize"

///|
fn mbw_mb_host_term_lines(id : Int) -> Int = "mbhost" "mb_host_term_lines"

///|
fn tm_lines(id : Int) -> String {
  @wasmrt.take_string(mbw_mb_host_term_lines(id))
}

///|
fn tm_close(id : Int) = "mbhost" "mb_host_term_close"

