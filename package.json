{
  "name": "ember",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "start": "node src/main.ts",
    "build": "sh client/wasm/build.sh && vite build --config web/vite.config.ts",
    "build:cloud": "sh client/wasm/build.sh && vite build --config web/vite.config.ts --mode cloud && vite build --config web/vite.config.ts --mode cloud-admin",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "sh scripts/shapes.sh --check && python3 scripts/icons.py --check && tsgo -p tsconfig.json && tsgo -p web/tsconfig.json",
    "test": "node --test --test-timeout=60000 \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^5.0.0",
    "posthog-js": "^1.434.14",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.9.0",
    "remark-gfm": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "posthog-node": "^5.54.1",
    "shiki": "^4.4.3"
  }
}
