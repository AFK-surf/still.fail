{
  "name": "stillfail",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "build": "sh client/wasm/build.sh && node scripts/posthog-key.ts",
    "build:cloud": "sh client/wasm/build.sh && vite build --config web/vite.config.ts --mode cloud && vite build --config web/vite.config.ts --mode cloud-admin && node cloud/build-static.ts",
    "dev:web": "vite --config web/vite.config.ts --mode cloud",
    "build:site": "vite build --config web/vite.demo.config.ts && vite build --config web/vite.demo.config.ts --ssr ../web/src/site/prerender.tsx --outDir ../dist/site-ssr && node web/site-prerender.mjs",
    "build:site-beta": "STILLFAIL_SITE=beta pnpm run build:site",
    "dev:site": "vite --config web/vite.demo.config.ts",
    "typecheck": "sh scripts/shapes.sh --check && python3 scripts/icons.py --check && tsgo -p tsconfig.json && tsgo -p web/tsconfig.json",
    "test": "node --test --test-timeout=60000 \"test/**/*.test.ts\"",
    "perf:chat": "node test/perf/chat.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "check": "sh scripts/check.sh all"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^5.0.0",
    "csstype": "^3.2.3",
    "mediabunny": "^1.60.0",
    "modern-screenshot": "^4.7.0",
    "motion": "^13.4.5",
    "pdfjs-dist": "^6.3.289",
    "posthog-js": "^1.434.14",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.9.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^4.4.3",
    "thumbhash": "^0.1.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
