{
  "name": "@stillfail/ts-station-proto",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsgo --noEmit",
    "bundle:esbuild": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/esbuild/main.js",
    "bundle:rolldown": "rolldown src/main.ts --platform node --format esm --file dist/rolldown/main.js",
    "transform:oxc": "node transform-oxc.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "esbuild": "0.28.2",
    "oxc-transform": "0.152.0",
    "rolldown": "1.2.12"
  }
}
