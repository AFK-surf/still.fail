// (Each formula one connective deep, the rest in predicates of their own: the lowering to WhyML prints `a && (b || c)`
// without its brackets.)

predicate at_most(result : Role, a : Role) {
  rank(result) <= rank(a)
}

predicate one_of(result : Role, a : Role, b : Role) {
  rank(result) == rank(a) || rank(result) == rank(b)
}

predicate lower_post(a : Role, b : Role, result : Role) {
  at_most(result, a) && at_most(result, b) && one_of(result, a, b)
}

predicate managing(who : Role) {
  rank(who) >= 2
}

predicate owning(who : Role) {
  rank(who) == 3
}

predicate owners_only(touches_owner : Bool, who : Role) {
  touches_owner → owning(who)
}

predicate own_or_managing(mine : Bool, who : Role) {
  mine || managing(who)
}

predicate member_set_ok(who : Role, was : Bool, becomes : Bool) {
  managing(who) && owners_only(was, who) && owners_only(becomes, who)
}

predicate may_post(who : Role, c : Change, result : Bool) {
  match c {
    MemberSet(was, becomes) => result → member_set_ok(who, was, becomes)
    MemberRemove(was) => result → member_set_ok(who, was, false)
    Own(mine) => result → own_or_managing(mine, who)
    Roster => result → managing(who)
    CloudKeys => result → owning(who)
    Disable => result → owning(who)
  }
}
