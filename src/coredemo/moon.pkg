import {
  "mbui/core",
  "mbui/host",
  "mbui/ui",
  "mbui/shelf",
  "mbui/gallery",
}

options(
  "is-main": true,
  targets: { "env_native.mbt": [ "native" ], "env_js.mbt": [ "js" ] },
  "native-stub": [ "core_engine.m" ],
  link: {
    "js": { "format": "iife" },
    "native": {
      "stub-cc-flags": "-fobjc-arc -O2",
      "cc-link-flags": "-framework Cocoa -framework Metal -framework QuartzCore -framework CoreText -framework CoreGraphics -framework ImageIO -framework JavaScriptCore -framework AuthenticationServices -framework SystemConfiguration -framework Security -framework CoreFoundation -framework Foundation -liconv out/core/aarch64-apple-darwin/libstillfail_shell.a -Wl,-dead_strip",
    },
  },
)
