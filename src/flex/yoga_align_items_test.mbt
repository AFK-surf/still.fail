///|
test "align_center_should_size_based_on_content" {
  let root = @flex.Node::new()
  root.style.position = Absolute
  root.style.width = Pt(100.0)
  root.style.height = Pt(100.0)
  root.style.align_items = Center
  root.style.margin.top = Pt(20.0)
  let root_child0 = @flex.Node::new()
  root_child0.style.shrink = 1.0
  root_child0.style.justify = Center
  root.add(root_child0)
  let root_child0_child0 = @flex.Node::new()
  root_child0_child0.style.grow = 1.0
  root_child0_child0.style.shrink = 1.0
  root_child0.add(root_child0_child0)
  let root_child0_child0_child0 = @flex.Node::new()
  root_child0_child0_child0.style.width = Pt(20.0)
  root_child0_child0_child0.style.height = Pt(20.0)
  root_child0_child0.add(root_child0_child0_child0)
  @flex.compute(root)
  check("root", root, 0.0, 20.0, 100.0, 100.0)
  check("root_child0", root_child0, 40.0, 0.0, 20.0, 20.0)
  check("root_child0_child0", root_child0_child0, 0.0, 0.0, 20.0, 20.0)
  check("root_child0_child0_child0", root_child0_child0_child0, 0.0, 0.0, 20.0, 20.0)
}

