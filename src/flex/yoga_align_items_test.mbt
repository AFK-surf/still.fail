///|
test "align_items_non_stretch_s526008" {
  let root = @flex.Node::new()
  root.style.position = Absolute
  root.style.width = Pt(400.0)
  root.style.height = Pt(400.0)
  let root_child0 = @flex.Node::new()
  root_child0.style.direction = Row
  root.add(root_child0)
  let root_child0_child0 = @flex.Node::new()
  root_child0_child0.style.align_items = FlexStart
  root_child0.add(root_child0_child0)
  let root_child0_child0_child0 = @flex.Node::new()
  root_child0_child0.add(root_child0_child0_child0)
  let root_child0_child0_child0_child0 = @flex.Node::new()
  root_child0_child0_child0_child0.style.width = Pt(0.0)
  root_child0_child0_child0_child0.style.height = Pt(10.0)
  root_child0_child0_child0.add(root_child0_child0_child0_child0)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 400.0, 400.0)
  check("root_child0", root_child0, 0.0, 0.0, 400.0, 10.0)
  check("root_child0_child0", root_child0_child0, 0.0, 0.0, 0.0, 10.0)
  check("root_child0_child0_child0", root_child0_child0_child0, 0.0, 0.0, 0.0, 10.0)
  check("root_child0_child0_child0_child0", root_child0_child0_child0_child0, 0.0, 0.0, 0.0, 10.0)
}
