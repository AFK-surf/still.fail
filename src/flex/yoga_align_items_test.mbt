///|
test "align_flex_end_with_row_reverse" {
  let root = @flex.Node::new()
  root.style.position = Absolute
  root.style.width = Pt(100.0)
  root.style.height = Pt(75.0)
  root.style.align_items = FlexEnd
  root.style.wrap = Wrap
  let root_child0 = @flex.Node::new()
  root_child0.style.width = Pt(50.0)
  root_child0.style.height = Pt(50.0)
  root_child0.style.margin.right = Pt(5.0)
  root_child0.style.margin.left = Pt(3.0)
  root.add(root_child0)
  let root_child1 = @flex.Node::new()
  root_child1.style.width = Pt(50.0)
  root_child1.style.height = Pt(50.0)
  root.add(root_child1)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 100.0, 75.0)
  check("root_child0", root_child0, 3.0, 0.0, 50.0, 50.0)
  check("root_child1", root_child1, 58.0, 0.0, 50.0, 50.0)
}

