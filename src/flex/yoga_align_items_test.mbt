  root_child2.style.width = Pt(50.0)
  root_child2.style.height = Pt(20.0)
  root.add(root_child2)
  let root_child2_child0 = @flex.Node::new()
  root_child2_child0.style.width = Pt(50.0)
  root_child2_child0.style.height = Pt(10.0)
  root_child2.add(root_child2_child0)
  let root_child3 = @flex.Node::new()
  root_child3.style.width = Pt(50.0)
  root_child3.style.height = Pt(20.0)
  root.add(root_child3)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 100.0, 100.0)
  check("root_child0", root_child0, 0.0, 0.0, 50.0, 50.0)
  check("root_child1", root_child1, 50.0, 40.0, 50.0, 50.0)
  check("root_child1_child0", root_child1_child0, 0.0, 0.0, 50.0, 10.0)
  check("root_child2", root_child2, 0.0, 100.0, 50.0, 20.0)
  check("root_child2_child0", root_child2_child0, 0.0, 0.0, 50.0, 10.0)
  check("root_child3", root_child3, 50.0, 90.0, 50.0, 20.0)
}

