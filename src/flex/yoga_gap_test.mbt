///|
test "row_gap_percent_wrapping_with_flexible_content" {
  let root = @flex.Node::new()
  root.style.position = Absolute
  root.style.direction = Row
  root.style.width = Pt(300.0)
  root.style.height = Pt(300.0)
  root.style.gap_col = Pct(10.0)
  root.style.gap_row = Pct(10.0)
  let root_child0 = @flex.Node::new()
  root_child0.style.grow = 1.0
  root_child0.style.shrink = 1.0
  root_child0.style.basis = Pct(0.0)
  root.add(root_child0)
  let root_child1 = @flex.Node::new()
  root_child1.style.grow = 1.0
  root_child1.style.shrink = 1.0
  root_child1.style.basis = Pct(0.0)
  root.add(root_child1)
  let root_child2 = @flex.Node::new()
  root_child2.style.grow = 1.0
  root_child2.style.shrink = 1.0
  root_child2.style.basis = Pct(0.0)
  root.add(root_child2)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 300.0, 300.0)
  check("root_child0", root_child0, 0.0, 0.0, 80.0, 300.0)
  check("root_child1", root_child1, 110.0, 0.0, 80.0, 300.0)
  check("root_child2", root_child2, 220.0, 0.0, 80.0, 300.0)
}

///|
test "row_gap_percent_wrapping_with_mixed_flexible_content" {
  let root = @flex.Node::new()
  root.style.position = Absolute
  root.style.direction = Row
  root.style.width = Pt(300.0)
  root.style.height = Pt(300.0)
  root.style.gap_col = Pct(10.0)
  root.style.gap_row = Pct(10.0)
  let root_child0 = @flex.Node::new()
  root_child0.style.width = Pt(10.0)
  root.add(root_child0)
  let root_child1 = @flex.Node::new()
  root_child1.style.grow = 1.0
  root_child1.style.shrink = 1.0
  root_child1.style.basis = Pct(0.0)
  root.add(root_child1)
  let root_child2 = @flex.Node::new()
  root_child2.style.width = Pct(10.0)
  root.add(root_child2)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 300.0, 300.0)
  check("root_child0", root_child0, 0.0, 0.0, 10.0, 300.0)
  check("root_child1", root_child1, 40.0, 0.0, 200.0, 300.0)
  check("root_child2", root_child2, 270.0, 0.0, 30.0, 300.0)
}
