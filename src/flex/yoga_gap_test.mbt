test "row_gap_percent_wrapping_with_content_margin" {
  let root = @flex.Node::new()
  root.style.position = Absolute
  root.style.direction = Row
  root.style.width = Pt(300.0)
  root.style.height = Pt(700.0)
  root.style.margin.left = Pt(10.0)
  root.style.margin.top = Pt(10.0)
  root.style.margin.right = Pt(10.0)
  root.style.margin.bottom = Pt(10.0)
  root.style.gap_col = Pct(10.0)
  root.style.gap_row = Pct(10.0)
  root.style.wrap = Wrap
  let root_child0 = @flex.Node::new()
  root_child0.style.width = Pt(100.0)
  root_child0.style.height = Pt(100.0)
  root.add(root_child0)
  let root_child1 = @flex.Node::new()
  root_child1.style.width = Pt(100.0)
  root_child1.style.height = Pt(100.0)
  root.add(root_child1)
  let root_child2 = @flex.Node::new()
  root_child2.style.width = Pt(100.0)
  root_child2.style.height = Pt(100.0)
  root.add(root_child2)
  let root_child3 = @flex.Node::new()
  root_child3.style.width = Pt(100.0)
  root_child3.style.height = Pt(100.0)
  root.add(root_child3)
  let root_child4 = @flex.Node::new()
  root_child4.style.width = Pt(100.0)
  root_child4.style.height = Pt(100.0)
  root.add(root_child4)
  @flex.compute(root)
  check("root", root, 10.0, 10.0, 300.0, 700.0)
  check("root_child0", root_child0, 0.0, 0.0, 100.0, 100.0)
  check("root_child1", root_child1, 130.0, 0.0, 100.0, 100.0)
  check("root_child2", root_child2, 0.0, 170.0, 100.0, 100.0)
  check("root_child3", root_child3, 130.0, 170.0, 100.0, 100.0)
  check("root_child4", root_child4, 0.0, 340.0, 100.0, 100.0)
}

