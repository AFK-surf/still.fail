  @flex.compute(root)
  check("root", root, 0.0, 0.0, 215.0, 301.0)
  check("root_child0", root_child0, 4.0, 5.0, 202.0, 295.0)
  check("root_child0_child0", root_child0_child0, 15.0, 21.0, 166.0, 244.0)
  check("root_child0_child0_child0", root_child0_child0_child0, 65.0, 29.0, 39.0, 92.0)
  check("root_child0_child0_child0_child0", root_child0_child0_child0_child0, 16.0, 16.0, 100.0, 50.0)
