///|
test "static_position_static_root" {
  let root = @flex.Node::new()
  root.style.height = Pt(200.0)
  root.style.width = Pt(100.0)
  root.style.position = Static
  root.style.padding.top = Pt(1.0)
  root.style.padding.right = Pt(11.0)
  root.style.padding.bottom = Pt(4.0)
  root.style.padding.left = Pt(6.0)
  let root_child0 = @flex.Node::new()
  root_child0.style.height = Pct(50.0)
  root_child0.style.width = Pct(50.0)
  root_child0.style.position = Absolute
  root_child0.style.border.top = Pt(3.0)
  root_child0.style.border.right = Pt(2.0)
  root_child0.style.border.bottom = Pt(1.0)
  root_child0.style.border.left = Pt(4.0)
  root_child0.style.padding.top = Pt(7.0)
  root_child0.style.padding.right = Pt(5.0)
  root_child0.style.padding.bottom = Pt(4.0)
  root_child0.style.padding.left = Pt(3.0)
  root_child0.style.margin.top = Pt(11.0)
  root_child0.style.margin.right = Pt(15.0)
  root_child0.style.margin.bottom = Pt(1.0)
  root_child0.style.margin.left = Pt(12.0)
  root.add(root_child0)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 100.0, 200.0)
  check("root_child0", root_child0, 18.0, 12.0, 50.0, 100.0)
}

///|
test "static_position_absolute_child_multiple" {
  let root = @flex.Node::new()
  root.style.position = Absolute
  let root_child0 = @flex.Node::new()
  root_child0.style.width = Pt(400.0)
  root_child0.style.height = Pt(400.0)
  root_child0.style.padding.left = Pt(100.0)
  root_child0.style.padding.top = Pt(100.0)
  root_child0.style.padding.right = Pt(100.0)
  root_child0.style.padding.bottom = Pt(100.0)
  root.add(root_child0)
  let root_child0_child0 = @flex.Node::new()
  root_child0_child0.style.height = Pt(100.0)
  root_child0_child0.style.width = Pt(100.0)
  root_child0_child0.style.position = Static
  root_child0.add(root_child0_child0)
  let root_child0_child0_child0 = @flex.Node::new()
  root_child0_child0_child0.style.height = Pt(50.0)
  root_child0_child0_child0.style.width = Pct(10.0)
  root_child0_child0_child0.style.position = Absolute
  root_child0_child0.add(root_child0_child0_child0)
  let root_child0_child1 = @flex.Node::new()
  root_child0_child1.style.height = Pt(100.0)
  root_child0_child1.style.width = Pt(100.0)
  root_child0_child1.style.position = Static
  root_child0.add(root_child0_child1)
  let root_child0_child1_child0 = @flex.Node::new()
  root_child0_child1_child0.style.height = Pt(50.0)
  root_child0_child1_child0.style.width = Pct(50.0)
  root_child0_child1_child0.style.position = Absolute
  root_child0_child1.add(root_child0_child1_child0)
  let root_child0_child1_child1 = @flex.Node::new()
  root_child0_child1_child1.style.height = Pt(50.0)
  root_child0_child1_child1.style.width = Pct(50.0)
  root_child0_child1_child1.style.position = Absolute
  root_child0_child1.add(root_child0_child1_child1)
  let root_child0_child2 = @flex.Node::new()
  root_child0_child2.style.height = Pt(50.0)
  root_child0_child2.style.width = Pt(25.0)
  root_child0_child2.style.position = Absolute
  root_child0.add(root_child0_child2)
  @flex.compute(root)
  check("root", root, 0.0, 0.0, 400.0, 400.0)
  check("root_child0", root_child0, 0.0, 0.0, 400.0, 400.0)
  check("root_child0_child0", root_child0_child0, 100.0, 100.0, 100.0, 100.0)
  check("root_child0_child0_child0", root_child0_child0_child0, 0.0, 0.0, 40.0, 50.0)
  check("root_child0_child1", root_child0_child1, 100.0, 200.0, 100.0, 100.0)
  check("root_child0_child1_child0", root_child0_child1_child0, 0.0, 0.0, 200.0, 50.0)
  check("root_child0_child1_child1", root_child0_child1_child1, 0.0, 0.0, 200.0, 50.0)
  check("root_child0_child2", root_child0_child2, 100.0, 100.0, 25.0, 50.0)
}
