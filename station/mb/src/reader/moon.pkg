import {
  "station/host",
  "station/wire",
  "station/sql",
  "station/marks",
  "moonbitlang/core/json",
}

pkgtype(kind: "executable")

options(
  link: {
    "native": {
      // client/shell, as build.sh puts it in out/ (the Mac's: its static library and what it links)
      "cc-link-flags": "out/libstillfail_shell.a -framework SystemConfiguration -framework Security -framework CoreFoundation -framework Foundation -liconv -lobjc -Wl,-dead_strip",
    },
  },
)
