{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": { "react": ["../node_modules/preact/compat"], "react-dom": ["../node_modules/preact/compat"], "react/jsx-runtime": ["../node_modules/preact/jsx-runtime"] },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["ui/src/**/*.ts", "ui/src/**/*.tsx", "ui/alias.ts", "src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "vite.share.config.ts"]
}
